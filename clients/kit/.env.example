# Settings for ONE client. `./new-client.sh` (or `./kit up` on first run) copies this to .env and
# replaces every CHANGE-ME with a fresh random value. Never commit or share .env.
# Passwords end up in connection URLs: use letters, digits, - and _ only.

# Shown in tool descriptions and docker container names (lowercase, digits, -)
COMPOSE_PROJECT_NAME=client-kit

# Postgres admin (owns the tables; only ./kit scripts use it, never the AI)
POSTGRES_DB=clientdata
POSTGRES_USER=kit_admin
POSTGRES_PASSWORD=CHANGE-ME

# Database logins the AI uses. Write login: read/add/update, no delete. Read-only login: read only.
MCP_DB_USER=kit_mcp
MCP_DB_PASSWORD=CHANGE-ME
MCP_RO_DB_USER=kit_mcp_ro
MCP_RO_DB_PASSWORD=CHANGE-ME

# Database login NocoDB uses (read/add/update, no delete; edits are receipted)
UI_DB_USER=kit_ui
UI_DB_PASSWORD=CHANGE-ME

# Remote access tokens (HTTP). Clients send "Authorization: Bearer <token>". 32+ characters.
#   MCP_TOKEN      = full access (read + write tools)
#   MCP_READ_TOKEN = read-only access (write tools hidden, read-only database login)
# Leave one empty to switch it off. Rotate: put a new value here, then ./kit restart
MCP_TOKEN=CHANGE-ME
MCP_READ_TOKEN=CHANGE-ME

# write = normal. read = the whole server is read-only, whatever token or transport is used.
KIT_SCOPE=write
# Optional: only these actor names may write, comma separated (empty = any actor)
ALLOWED_WRITE_ACTORS=
# How long an archive approval code stays valid (hours, max 168)
APPROVAL_TTL_HOURS=24

# NocoDB (the spreadsheet-style screen for the client)
NOCODB_META_DB=nocodb_meta
NC_AUTH_JWT_SECRET=CHANGE-ME

# Ports on this machine. BIND_ADDR=127.0.0.1 means only this machine can connect; reach it
# from outside through a Cloudflare tunnel or Tailscale (see README), not by opening ports.
BIND_ADDR=127.0.0.1
POSTGRES_PORT=5442
NOCODB_PORT=8090
MCP_PORT=8790
