#!/usr/bin/env bash
# ./kit <command>   -- run one client's stack. Run ./kit with no command for help.
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/scripts/lib.sh"
cd "$ROOT"

usage() { cat <<'U'
./kit up             start everything (first run makes .env with fresh secrets), apply client/schema.json
./kit seed           load client/seed.json into tables that are still empty
./kit status         what's running, record counts, receipt check
./kit check          check client/schema.json and client/seed.json for mistakes
./kit verify         recompute the receipt hash chain and check the append-only lock
./kit anchor [W A [G]]  one JSON line: verify result + head seq/hash of every log (for off-server copies);
                     W A G = previously anchored write_log / access_log / agent_log seq, to also print the hash now stored there
./kit pending        list archive requests waiting for approval
./kit approve CODE   approve an archive (soft delete) the AI asked for; a person must type yes
                     at a real terminal (refuses when run from a script, pipe or AI tool)
./kit mcp-stdio      what Claude Desktop / Claude Code run locally (stdio MCP)
./kit logs [svc]     follow logs (postgres, mcp, nocodb)
./kit restart        restart the MCP server (e.g. after changing tokens in .env)
./kit backup         save a database dump into backups/ (encrypted with age if KIT_BACKUP_AGE_RECIPIENT is set)
./kit receipts-setup [--url URL] [--claude [SETTINGS.json]] [--env-file PATH]
                     receipt what AIs do on a machine (commands, file edits) into agent_log: writes the
                     hook's private settings file; --claude also adds the hook to Claude Code's settings
./kit receipts [N]   the newest N agent_log receipts (default 20)
./kit money FILE...  read the business's bank / sales / supplier CSVs, write a "where the money went"
                     report into money-reports/<time>/ (prefix a file with bank: sales: purchases: to force its kind)
./kit money add-tables   add the Money Transactions + Money Findings tables to client/schema.json
./kit money load [DIR]   put a report's rows into those tables (default: the newest report; repeats are skipped)
./kit test           full self-test on a throwaway copy (your data is not touched)
./kit down           stop everything, keep the data
./kit wipe           stop and DELETE all data for this client (asks first)
U
}

approval_info_sql() { cat <<'SQL'
SELECT 'Archive ' || a.table_name || ' #' || a.record_id || E'\n  reason:       ' || a.reason || E'\n  requested by: ' || a.requested_by ||
       E'\n  record now:   ' || coalesce((SELECT (xpath('/row/r/text()', query_to_xml(format('SELECT to_jsonb(t)::text AS r FROM %I t WHERE id = %s', a.table_name, a.record_id), false, true, '')))[1]::text), '(not found)')
  FROM approvals a WHERE a.code = upper(:'c')
SQL
}

ensure_env() {
  if [ ! -f "$KIT_ENV_FILE" ]; then
    make_env "$ROOT/.env.example" "$KIT_ENV_FILE" "$(basename "$KIT_HOME" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '-')"
    say "created .env with fresh random secrets (private: never share or commit it)"
  fi
  load_env
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  up)
    ensure_env
    dc build mcp >/dev/null
    dc up -d postgres
    wait_pg
    apply_schema
    dc up -d mcp
    if [ "${KIT_NO_UI:-0}" != 1 ]; then dc --profile ui up -d nocodb; fi
    wait_mcp
    bold "up: ${COMPOSE_PROJECT_NAME}"
    say "  MCP (HTTP)  http://127.0.0.1:${MCP_HOST_PORT}/mcp   (needs Authorization: Bearer <MCP_TOKEN from .env>)"
    [ "${KIT_NO_UI:-0}" = 1 ] || say "  NocoDB      http://127.0.0.1:${NOCODB_PORT:-8090}   (first start takes ~30s; see README to connect it)"
    say "  Postgres    127.0.0.1:${POSTGRES_PORT:-5442}  db=${POSTGRES_DB}"
    say "  scope       ${KIT_SCOPE:-write}"
    ;;
  seed)
    load_env
    kit_cli seed-sql | admin_psql -q >/dev/null
    say "seeded (tables that already had data were left alone)"
    admin_psql -t -A -c "SELECT display_name || ': ' || (xpath('/row/c/text()', query_to_xml(format('SELECT count(*) AS c FROM %I', sql_name), false, true, '')))[1]::text || ' records' FROM kit_tables ORDER BY 1"
    ;;
  check)
    load_env; kit_cli check ;;
  status)
    load_env
    dc --profile ui ps
    admin_psql -t -A -c "SELECT display_name || ': ' || (xpath('/row/c/text()', query_to_xml(format('SELECT count(*) AS c FROM %I', sql_name), false, true, '')))[1]::text || ' records' FROM kit_tables ORDER BY 1" || true
    "$0" verify || true
    ;;
  verify)
    load_env
    out="$(admin_psql -t -A -F '|' -c "SELECT chain, rows_checked, intact, coalesce(first_bad_seq::text,''), coalesce(problem,''), coalesce(head_hash,''), lock_on, coalesce(lock_problem,'') FROM kit_verify()")" || { echo "could not run the check (is it running? ./kit up)" >&2; exit 2; }
    bad=0
    while IFS='|' read -r chain rows intact fbad problem head lock lockp; do
      [ -n "$chain" ] || continue
      if [ "$intact" = t ]; then printf 'INTACT  %-10s rows=%-6s head=%s\n' "$chain" "$rows" "${head:-(empty)}"
      else bad=1; printf 'BROKEN  %-10s rows=%-6s first bad row #%s: %s\n' "$chain" "$rows" "$fbad" "$problem"; fi
      if [ "$lock" = t ]; then printf '        lock ON (UPDATE/DELETE/TRUNCATE refused)\n'
      else bad=1; printf '        lock OFF: %s\n' "$lockp"; fi
    done <<EOT
$out
EOT
    if [ $bad = 0 ]; then say "all receipts intact. Tip: copy the head hashes somewhere outside this server now and then."; exit 0; fi
    echo "PROBLEM: receipts were altered or unlocked outside the normal path." >&2; exit 1
    ;;
  anchor)
    # One JSON line for an off-server "anchor" copy (scripts/mac-anchor.sh keeps them on the Mac).
    # Optional W A = write_log / access_log seq numbers anchored earlier: the line then also carries
    # the hash the database holds at those seqs NOW, so the Mac can spot a rewritten history.
    # Exit 0 = intact and locked, 1 = verify found a problem (the line is still printed), 2 = could not run.
    cw="${1:-0}"; ca="${2:-0}"; cg="${3:-0}"
    [ $# -le 3 ] || die "usage: ./kit anchor [WRITE_LOG_SEQ ACCESS_LOG_SEQ [AGENT_LOG_SEQ]]"
    case "$cw$ca$cg" in *[!0-9]*) die "anchor: seq numbers must be whole numbers" ;; esac
    [ ${#cw} -le 18 ] && [ ${#ca} -le 18 ] && [ ${#cg} -le 18 ] || die "anchor: seq number too large"
    load_env
    row="$(admin_psql -q -t -A -F '|' -v cw="$cw" -v ca="$ca" -v cg="$cg" <<'SQL'
BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;
WITH v AS (SELECT * FROM kit_verify()),
     w AS (SELECT * FROM v WHERE chain = 'write_log'),
     a AS (SELECT * FROM v WHERE chain = 'access_log'),
     g AS (SELECT * FROM v WHERE chain = 'agent_log')
SELECT to_char(now() AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS"Z"'),
       (SELECT bool_and(intact AND lock_on) FROM v),
       (SELECT coalesce(max(seq), 0) FROM write_log),  coalesce((SELECT head_hash FROM w), ''),
       (SELECT intact FROM w), (SELECT lock_on FROM w),
       (SELECT coalesce(max(seq), 0) FROM access_log), coalesce((SELECT head_hash FROM a), ''),
       (SELECT intact FROM a), (SELECT lock_on FROM a),
       coalesce((SELECT hash FROM write_log  WHERE seq = :'cw'::bigint), ''),
       coalesce((SELECT hash FROM access_log WHERE seq = :'ca'::bigint), ''),
       (SELECT coalesce(max(seq), 0) FROM agent_log), coalesce((SELECT head_hash FROM g), ''),
       (SELECT intact FROM g), (SELECT lock_on FROM g),
       coalesce((SELECT hash FROM agent_log WHERE seq = :'cg'::bigint), '');
COMMIT;
SQL
)" || { echo "anchor: could not run the check (is it running? ./kit up)" >&2; exit 2; }
    IFS='|' read -r at good wseq whead wint wlock aseq ahead aint alock cwh cah gseq ghead gint glock cgh <<EOT
$row
EOT
    gseq="${gseq:-0}"
    [ -n "${at:-}" ] || { echo "anchor: empty answer from the database" >&2; exit 2; }
    b() { [ "$1" = t ] && echo true || echo false; }
    s() { [ -n "$1" ] && printf '"%s"' "$1" || printf 'null'; }
    printf '{"v":1,"project":"%s","at":"%s","intact":%s,"write_log_seq":%s,"write_log_head":%s,"write_log_intact":%s,"write_log_lock":%s,"access_log_seq":%s,"access_log_head":%s,"access_log_intact":%s,"access_log_lock":%s,"check_write_log_seq":%s,"check_write_log_hash":%s,"check_access_log_seq":%s,"check_access_log_hash":%s,"agent_log_seq":%s,"agent_log_head":%s,"agent_log_intact":%s,"agent_log_lock":%s,"check_agent_log_seq":%s,"check_agent_log_hash":%s}\n' \
      "$COMPOSE_PROJECT_NAME" "$at" "$(b "$good")" "$wseq" "$(s "$whead")" "$(b "$wint")" "$(b "$wlock")" \
      "$aseq" "$(s "$ahead")" "$(b "$aint")" "$(b "$alock")" "$((10#$cw))" "$(s "$cwh")" "$((10#$ca))" "$(s "$cah")" \
      "$gseq" "$(s "$ghead")" "$(b "$gint")" "$(b "$glock")" "$((10#$cg))" "$(s "$cgh")"
    [ "$good" = t ] || exit 1
    ;;
  pending)
    load_env
    admin_psql -P pager=off -c "SELECT code, table_name AS table, record_id AS id, reason, requested_by, to_char(expires_at, 'YYYY-MM-DD HH24:MI TZ') AS expires FROM approvals WHERE approved_at IS NULL AND used_at IS NULL AND expires_at > now() ORDER BY created_at"
    ;;
  approve)
    # A person approves, at a terminal, by typing yes. There is deliberately no --yes / no-prompt
    # option, and the command refuses to run when stdin is not a terminal (a script, a pipe, or an
    # AI tool running commands), before it touches the database.
    code="${1:-}"; [ -n "$code" ] || die "usage: ./kit approve CODE"
    [ $# -eq 1 ] || die "usage: ./kit approve CODE (no options: a person must type yes at a terminal). Nothing was approved."
    case "$code" in *[!A-Za-z0-9-]*) die "that doesn't look like an approval code" ;; esac
    [ -t 0 ] || die "refusing to approve: ./kit approve must be run by a person at a terminal (stdin is not a TTY). Nothing was approved."
    load_env
    info="$(approval_info_sql | admin_psql -t -A -v c="$code")"
    [ -n "$info" ] || die "no request with code $code (see ./kit pending)"
    say "$info"
    printf 'Approve this? Type yes: '; read -r ans
    [ "$ans" = yes ] || { say "not approved."; exit 1; }
    by="$(id -un 2>/dev/null || echo owner)@$(hostname -s 2>/dev/null || hostname)"
    admin_psql -t -A -v c="$code" -v by="$by" 2>&1 <<'SQL' | grep -v -e '^$' -e '^CONTEXT' || true
SELECT kit_approve(:'c', :'by');
SQL
    admin_psql -t -A -v c="$code" <<'SQL'
SELECT CASE WHEN approved_at IS NOT NULL THEN 'APPROVED. Tell the AI it can now call archive_record with approval_code ' || code ELSE 'NOT approved' END FROM approvals WHERE code = upper(:'c')
SQL
    ;;
  money)
    # The business's own exports -> report (money/money.py, Python standard library only, runs on this machine).
    # Bank statements are private: reports go in the client's own folder (git-ignored), readable only by this user.
    sub="${1:-}"
    REPORTS="$KIT_HOME/money-reports"
    case "$sub" in
      ""|-h|--help) usage | grep -e '^./kit money' -e '^   '; exit 0 ;;
      add-tables)
        sch="$KIT_CLIENT_DIR/schema.json"
        [ "$KIT_CLIENT_DIR" != "$ROOT/examples/inventory" ] || die "this is the kit's own example; run it from a client's folder (clients/<name>/kit money add-tables)"
        cp -p "$sch" "$sch.bak-$(date +%Y%m%d-%H%M%S)"
        python3 -I - "$sch" "$ROOT/money/tables.json" <<'PY'
import json, sys
sch, add = sys.argv[1], json.load(open(sys.argv[2]))
s = json.load(open(sch))
have = {t["name"].lower() for t in s["tables"]}
new = [t for t in add["tables"] if t["name"].lower() not in have]
s["tables"] += new
open(sch, "w").write(json.dumps(s, indent=2) + "\n")
print("added: " + (", ".join(t["name"] for t in new) or "nothing (both tables were already there)"))
PY
        say "schema.json saved (old copy next to it as schema.json.bak-*)"
        load_env
        if admin_psql -t -A -c 'SELECT 1' >/dev/null 2>&1; then dc build mcp >/dev/null; apply_schema; say "tables created in the database"
        else say "the database isn't running; the tables are made on the next ./kit up"; fi
        ;;
      load)
        dir="${2:-}"
        if [ -z "$dir" ]; then dir="$(ls -1d "$REPORTS"/*/ 2>/dev/null | sort | tail -1)"; fi
        dir="${dir%/}"
        [ -f "$dir/load.json" ] || die "no report to load (run ./kit money FILE... first, or give the report folder)"
        load_env
        dc build mcp >/dev/null
        before="$(admin_psql -t -A -c "SELECT (SELECT count(*) FROM money_transactions) || ' ' || (SELECT count(*) FROM money_findings)" 2>/dev/null)" \
          || die "the money tables aren't in the database yet: run ./kit money add-tables (and ./kit up if it isn't running)"
        kit_cli insert-sql "money import ($(basename "$dir"))" < "$dir/load.json" | admin_psql -q >/dev/null || die "load failed; nothing was added (it runs as one transaction)"
        after="$(admin_psql -t -A -c "SELECT (SELECT count(*) FROM money_transactions) || ' ' || (SELECT count(*) FROM money_findings)")"
        set -- $before $after
        say "loaded $(basename "$dir"): $(( $3 - $1 )) new transactions ($3 in total), $(( $4 - $2 )) new findings ($4 in total). Rows already there were skipped."
        say "every new row has a receipt in write_log (./kit verify checks them)"
        ;;
      *)
        [ "$sub" = run ] && shift
        [ $# -gt 0 ] || die "usage: ./kit money FILE.csv [FILE.csv ...]"
        command -v python3 >/dev/null || die "needs python3 on this machine"
        out="$REPORTS/$(date +%Y%m%d-%H%M%S)"
        ( umask 077; mkdir -p "$out" )
        name="$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("client",""))' "$KIT_CLIENT_DIR/schema.json" 2>/dev/null || true)"
        rules=(); [ -f "$KIT_CLIENT_DIR/money-rules.json" ] && rules=(--rules "$KIT_CLIENT_DIR/money-rules.json")
        python3 -I "$ROOT/money/money.py" "$@" --out "$out" --name "$name" ${rules[@]+"${rules[@]}"}
        say "next: open $out/report.html, or ./kit money load to put it in the database (NocoDB shows it)"
        ;;
    esac
    ;;
  mcp-stdio)
    load_env
    # nothing but MCP messages may go to stdout from here on
    if [ "${MCP_LOCAL:-0}" = 1 ]; then
      export MCP_HOST_LABEL="$(hostname -s 2>/dev/null || hostname)" MCP_USER_LABEL="$(id -un)" KIT_SCHEMA="$KIT_CLIENT_DIR/schema.json"
      exec node "$ROOT/mcp/dist/src/stdio.js"
    fi
    scope_args=""; [ -n "${SCOPE:-}" ] && scope_args="-e KIT_SCOPE=$SCOPE"
    # shellcheck disable=SC2086
    exec $COMPOSE --env-file "$KIT_ENV_FILE" -p "$COMPOSE_PROJECT_NAME" run --rm -T --no-deps \
      -e MCP_STDIO=1 -e MCP_HOST_LABEL="$(hostname -s 2>/dev/null || hostname)" -e MCP_USER_LABEL="$(id -un)" $scope_args \
      mcp node dist/src/stdio.js
    ;;
  receipts-setup)
    # Run on the machine whose AI you want receipted. Writes the hook's settings file (private, 0600) with
    # the receipt URL and RECEIPT_TOKEN; the token is never printed. Another machine: pass --url (an https
    # or Tailscale address of this kit) and --env-file, then move that file over a private channel.
    load_env
    if [ -z "${RECEIPT_TOKEN:-}" ] || [ "$RECEIPT_TOKEN" = CHANGE-ME ]; then
      # a client made before AI receipts existed: give it a receipt token (kept in .env, never printed)
      RECEIPT_TOKEN="$(rand 32)"
      { grep -v '^RECEIPT_TOKEN=' "$KIT_ENV_FILE"; echo "RECEIPT_TOKEN=$RECEIPT_TOKEN"; } > "$KIT_ENV_FILE.tmp"
      chmod 600 "$KIT_ENV_FILE.tmp"; mv "$KIT_ENV_FILE.tmp" "$KIT_ENV_FILE"
      export RECEIPT_TOKEN; write_secrets
      say "added a new RECEIPT_TOKEN to $KIT_ENV_FILE"
      if [ -n "$(dc ps -q mcp 2>/dev/null)" ]; then
        dc up -d --force-recreate --no-deps mcp >/dev/null 2>&1 && wait_mcp && say "restarted the MCP server so it accepts the new token" \
          || die "could not restart the MCP server: run ./kit up"
      fi
    fi
    url=""; claude=""; envf="$HOME/.config/kit-receipts/env"
    while [ $# -gt 0 ]; do
      case "$1" in
        --url) url="${2:?--url needs a value}"; shift 2 ;;
        --env-file) envf="${2:?--env-file needs a path}"; shift 2 ;;
        --claude) if [ -n "${2:-}" ] && [ "${2#--}" = "$2" ]; then claude="$2"; shift 2; else claude="$HOME/.claude/settings.json"; shift; fi ;;
        *) die "unknown option $1" ;;
      esac
    done
    [ -n "$url" ] || url="http://127.0.0.1:${MCP_PORT:-8790}/receipts"
    ( umask 077; mkdir -p "$(dirname "$envf")"
      printf '# client kit AI receipts (made by ./kit receipts-setup). Private: never share.\nKIT_RECEIPT_URL=%s\nKIT_RECEIPT_TOKEN=%s\n' "$url" "$RECEIPT_TOKEN" > "$envf.tmp" && mv "$envf.tmp" "$envf" )
    chmod 600 "$envf"
    say "wrote $envf (private, 0600): receipts go to $url"
    hook="$ROOT/hooks/agent-receipt.py"
    if [ -n "$claude" ]; then
      python3 -I - "$claude" "$hook" <<'PY'
import json, os, sys
path, hook = sys.argv[1], sys.argv[2]
cfg = json.load(open(path)) if os.path.exists(path) and os.path.getsize(path) else {}
cmd = f'python3 -I "{hook}" hook "Claude Code"'
hooks = cfg.setdefault("hooks", {})
added = 0
for ev in ("PostToolUse", "PostToolUseFailure"):
    lst = hooks.setdefault(ev, [])
    if any(h.get("command") == cmd for m in lst for h in m.get("hooks", [])):
        continue
    lst.append({"matcher": "*", "hooks": [{"type": "command", "command": cmd, "timeout": 10}]})
    added += 1
os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(cfg, f, indent=2); f.write("\n")
os.replace(tmp, path)
print(f"Claude Code: {'added the hook to' if added else 'hook already in'} {path}")
PY
    else
      say "Claude Code: add to ~/.claude/settings.json (or run again with --claude):"
      say "  \"hooks\": {\"PostToolUse\": [{\"matcher\": \"*\", \"hooks\": [{\"type\": \"command\", \"command\": \"python3 -I $hook hook 'Claude Code'\"}]}]}"
    fi
    say "Shell commands too (zsh, in ~/.zshrc):"
    say "  precmd() { local e=\$?; [ -n \"\$_kit_cmd\" ] && python3 -I $hook shell \$e \"\$_kit_cmd\"; _kit_cmd=; }; preexec() { _kit_cmd=\"\$1\"; }"
    say "Check: python3 $hook status"
    ;;
  receipts)
    load_env
    admin_psql -P pager=off -c "SELECT seq, to_char(coalesce(at, created_at), 'YYYY-MM-DD HH24:MI:SS') AS at, actor, host, kind, ok, left(coalesce(target, command), 90) AS what, left(hash, 12) AS hash FROM agent_log ORDER BY seq DESC LIMIT ${1:-20}"
    ;;
  logs)    load_env; dc --profile ui logs -f --tail 100 "$@" ;;
  restart) load_env; dc up -d --force-recreate mcp; wait_mcp; say "MCP restarted on port $MCP_HOST_PORT" ;;
  backup)
    # Encrypted with age when KIT_BACKUP_AGE_RECIPIENT is set (an age public key, age1...): only the matching
    # private key can open it, so the file is safe to copy off this machine. Without it: a plain dump + a warning.
    load_env; ( umask 077; mkdir -p "$KIT_HOME/backups" ); f="$KIT_HOME/backups/${COMPOSE_PROJECT_NAME}-$(date +%Y%m%d-%H%M%S).sql"
    if [ -n "${KIT_BACKUP_AGE_RECIPIENT:-}" ]; then
      command -v age >/dev/null 2>&1 || die "KIT_BACKUP_AGE_RECIPIENT is set but age is not installed (brew install age / apt install age)"
      f="$f.age"
      ( umask 077; set -o pipefail; dc exec -T postgres pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" | age -r "$KIT_BACKUP_AGE_RECIPIENT" > "$f" ) \
        || { rm -f "$f"; die "backup failed"; }
      say "saved $f ($(wc -c < "$f" | tr -d ' ') bytes), encrypted. Open with: age -d -i <your key file> \"$f\" > dump.sql"
      say "Keep a copy somewhere other than this machine."
    else
      ( umask 077; dc exec -T postgres pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" > "$f" )
      say "saved $f ($(wc -c < "$f" | tr -d ' ') bytes). NOT encrypted: it contains the client's data."
      say "To encrypt backups: set KIT_BACKUP_AGE_RECIPIENT=age1... in .env (make a key with: age-keygen -o key.txt)."
    fi
    ;;
  test) exec "$ROOT/scripts/test.sh" "$@" ;;
  down) load_env; dc --profile ui down; say "stopped (data kept). Start again: ./kit up" ;;
  wipe)
    load_env
    bold "This DELETES every record, receipt and NocoDB setting for '${COMPOSE_PROJECT_NAME}'. It cannot be undone."
    say "Make a backup first if you might want it: ./kit backup"
    printf 'Type the project name (%s) to confirm: ' "$COMPOSE_PROJECT_NAME"; read -r ans
    [ "$ans" = "$COMPOSE_PROJECT_NAME" ] || { say "cancelled."; exit 1; }
    dc --profile ui down -v --remove-orphans
    docker image rm "${COMPOSE_PROJECT_NAME}-mcp:local" >/dev/null 2>&1 || true
    say "wiped. .env and client/ are still here; ./kit up starts fresh. Delete the folder to remove everything."
    ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
