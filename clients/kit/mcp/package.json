{
  "name": "client-kit-mcp",
  "version": "1.0.0",
  "description": "MCP server that gives an AI assistant safe, receipted read/write access to one client's Postgres tables. Tables come from client/schema.json.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "stdio": "node dist/src/stdio.js",
    "http": "node dist/src/http.js",
    "e2e": "node dist/test/e2e.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "pg": "8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=20" }
}
