# Optional. Copy to .env (never commit it). Database settings are NOT needed here: fixloop reads
# them from ragnarok/data/.env (the data layer's one Postgres). Set FIXLOOP_PG_* only to override.
# Ollama must be on this machine or your LAN (no cloud AI). The alexus box is alexus.local.
FIXLOOP_OLLAMA_HOST=http://alexus.local:11434
FIXLOOP_CODER_MODEL=qwen2.5-coder:7b
FIXLOOP_EMBED_MODEL=nomic-embed-text
FIXLOOP_RUNNER_IMAGE=ragnarok-brain-runner:local
FIXLOOP_MAX_TRIES=5
FIXLOOP_MIN_SIMILARITY=0.97
FIXLOOP_CANDIDATES=3
