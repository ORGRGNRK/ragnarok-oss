    os.chmod(codex_fail, 0o755)
    check("antigravity-removed", "antigravity" not in HANDOFF_ORDER and "antigravity" not in CRITIC_RING)
    # a short result must not replace the longer reply (a hook can leave a stub as the last line)

    # proved mode: fake claude that misses a check, then fixes it and tries to weaken the checklist; a critic that
    # refutes once, then passes. A HUMAN line is left, so the outcome is "needs you".
    fake = bin_dir / "claude-proved"
    fake.write_text(r"""#!/bin/bash
D="$RAGNAROK_AGENTS_DIR/$RAGNAROK_AGENT_RUN"; N="$D/fake-legs"; C="$D/fake-critics"
emit() { printf '%s\n' "$1"; }
done_() { emit '{"type":"result","is_error":false,"result":"DONE: fake work here\nLEFT: nothing","total_cost_usd":0.5,"num_turns":1,"session_id":"sess-p"}'; }
if [[ "$*" == *"VERDICT: pass"* ]]; then
  c=$(( $(cat "$C" 2>/dev/null || echo 0) + 1 )); echo $c > "$C"
  emit '{"type":"system","subtype":"init","session_id":"sess-critic"}'
  emit '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"r","name":"Read","input":{"file_path":"out.txt"}}]}}'
  if [ $c = 1 ]; then v='REFUTED: out.txt has no date\nVERDICT: fail'; else v='CONFIRMED: out.txt fine\nVERDICT: pass'; fi
  emit '{"type":"result","is_error":false,"result":"'"$v"'","total_cost_usd":0.25,"num_turns":1}'; exit 0
fi
n=$(( $(cat "$N" 2>/dev/null || echo 0) + 1 )); echo $n > "$N"
emit '{"type":"system","subtype":"init","session_id":"sess-p"}'
case "$MODE:$n" in
  good:1) printf -- '- [ ] out.txt exists :: verify: test -s out.txt\n- [ ] Owner likes it :: verify: HUMAN\n' > "$D/checklist.md" ;;
  good:2) echo hello > out.txt
          printf -- '- [ ] out.txt exists :: verify: true\n- [ ] new line :: verify: grep -q hello out.txt\n' > "$D/checklist.md" ;;
  good:3) date >> out.txt ;;
  stuck:1) printf -- '- [ ] never :: verify: test -f nope\n' > "$D/checklist.md" ;;
  write:1) printf -- '- [ ] sandbox :: verify: touch "$HOME/.ragnarok-sbx-test"\n' > "$D/checklist.md" ;;
esac
done_
""")
    os.chmod(fake, 0o755)

    def proved_run(mode):
        os.environ["MODE"] = mode
        tmp = Path(tempfile.mkdtemp(prefix="ragnarok-agent-p-"))
        os.environ.update(RAGNAROK_AGENTS_DIR=str(tmp), RAGNAROK_AGENT_NO_RECEIPT="1", RAGNAROK_AGENT_CLAUDE=str(fake))
        rid = "p-" + mode
        (tmp / rid).mkdir()
        save(tmp / rid, {"id": rid, "name": rid, "task": "make out.txt", "cwd": str(tmp), "who": "claude",
                         "mode": "proved", "model": None, "status": "starting", "started": now(), "ended": None,
                         "now": "", "plan": [], "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0,
                         "remark": "", "final": "", "cost_usd": None, "turns": None, "session": None, "pid": None})
        run(rid)
        return load(tmp / rid), tmp

    ps, ptmp = proved_run("good")
    claims = {c["claim"]: c for c in ps.get("checks") or []}
    check("proved-loop", ps["verdict"] == "needs you" and ps["status"] == "done"
          and (ptmp / "p-good/fake-legs").read_text().strip() == "3"
          and (ptmp / "p-good/fake-critics").read_text().strip() == "2"
          and ps["critic"]["verdict"] == "pass" and abs(ps["cost_usd"] - 2.0) < 1e-9)
    check("proved-freeze", claims.get("out.txt exists", {}).get("cmd") == "test -s out.txt"
          and "first version" in claims.get("out.txt exists", {}).get("restored", "")
          and claims.get("new line", {}).get("added") and claims.get("Owner likes it", {}).get("ok") is None)
    ss, _ = proved_run("stuck")
    check("proved-dead-end", ss["verdict"] == "dead end" and ss["status"] == "failed" and "nothing new" in ss["verdict_note"])
    check("stuck-checklist-no-handoff", unfinished_reason(
        {"status": "failed"}, "dead end",
        "round 3 proved nothing new (same 3 failures, 22 of 25 checks pass)") is None)
    check("stuck-phrases", all(checklist_stuck(s) for s in (
        "round 2 proved nothing new",
        "4 fix rounds and 2 checks still fail",
        "the critic refuted the same thing twice: x",
        "4 rounds; the critic still says: y",
    )) and not checklist_stuck("the critic ended without a verdict")
        and not checklist_stuck("the agent never wrote a checklist"))
    quota_reason = unfinished_reason({"status": "failed", "final": "Individual quota reached"}, None, None)
    check("quota-still-hands-off", quota_reason is not None and "quota" in quota_reason.lower())
    check("critic-no-verdict-hands-off", unfinished_reason(
        {"status": "failed"}, "dead end", "the critic ended without a verdict: quota") is not None)
    question_left = unfinished_reason(
        {"status": "done", "final": "DONE: x\nLEFT: the archive is not attached?"}, None, None)
    check("question-left-still-hands-off", question_left is not None and "archive" in question_left)
    check("left-question-is-not-human", extract_human_request(
        {"final": "DONE: x\nLEFT: the archive is not attached?", "checks": []}) is None)
    check("left-your-is-not-human", extract_human_request(
        {"final": "DONE: x\nLEFT: your notes are in the file", "checks": []}) is None)
    sudo_left = extract_human_request(
        {"final": "DONE: x\nLEFT: needs sudo to install the service", "checks": []})
    check("left-sudo-is-human", sudo_left is not None and "sudo" in sudo_left)
    check("outside-git-status", outside_reason("git status --short", " M brain/x") is not None)
    check("named-git-diff-stays", outside_reason("git diff -- runner/debug-pipeline", "") is None)
    check("outside-ssh", outside_reason("ssh alexus docker ps", "operation not permitted") is not None)
    check("local-test-stays", outside_reason("test -f nope", "exit 1") is None)
    check("git-diff-head-is-whole-repo", whole_repo_git("git diff HEAD") is True)
    check("echo-ssh-is-not-remote", outside_reason("echo ssh", "ssh") is None)
    sink_dir = Path(tempfile.mkdtemp(prefix="ragnarok-stderr-"))
    sink = sink_dir / "rows.jsonl"
    os.environ["RAGNAROK_ERROR_SINK"] = str(sink)
    stderr_body = "tail-mark\n" + ("x" * 2500) + "\nsk-ant-" + ("a" * 24)
    st_err = {"id": "stderr-test"}
    record_model_stderr(sink_dir, st_err, stderr_body, 0, "grok", "working")
    stderr_row = sink.read_text()
    kept_err = st_err.get("model_stderr") or ""
    check("model-stderr-full-on-exit-zero",
          "tail-mark" in stderr_row and ("x" * 2500) in stderr_row and "sk-ant-" not in stderr_row
          and "[hidden:anthropic-key]" in stderr_row and '"exit_code": "0"' in stderr_row
          and "sk-ant-" not in kept_err and ("x" * 2500) in kept_err)
    blank_before = sink.read_text()
    record_model_stderr(sink_dir, {"id": "stderr-test"}, " \n", 1, "grok", "")
    check("blank-stderr-not-pushed", sink.read_text() == blank_before)
    long_err = ("y" * 2500) + "\nboom"
    check("stderr-final-untruncated",
          stderr_as_final("RAW", 0, "grok", long_err) == long_err.strip()
          and stderr_as_final("", 2, "grok", None) == "grok exited 2 without a result")
    check("stderr-final-uses-scrubbed",
          stderr_as_final("sk-ant-" + ("a" * 24), 0, "grok", "[hidden:anthropic-key]") == "[hidden:anthropic-key]")
    os.environ.pop("RAGNAROK_ERROR_SINK", None)
    os.environ["RAGNAROK_ERROR_PG"] = "/usr/bin/false"
    fail_dir = Path(tempfile.mkdtemp(prefix="ragnarok-stderr-fail-"))
    st_fail = {"id": "stderr-fail"}
    record_model_stderr(fail_dir, st_fail, stderr_body, 0, "grok", "down")
    local_err = (fail_dir / "model-stderr.log").read_text()
    check("stderr-scrubbed-when-postgres-down",
          "sk-ant-" not in local_err and "[hidden:anthropic-key]" in local_err and ("x" * 2500) in local_err
          and "sk-ant-" not in (st_fail.get("model_stderr") or ""))
    os.environ.pop("RAGNAROK_ERROR_PG", None)
    os.environ["RAGNAROK_ERROR_SINK"] = "off"
    ws, _ = proved_run("write")
    check("proved-sandbox", ws["checks"][0]["ok"] is False and not (Path.home() / ".ragnarok-sbx-test").exists())

    # Check force-stop
    stop_tmp = Path(tempfile.mkdtemp(prefix="ragnarok-agent-stop-"))
    os.environ["RAGNAROK_AGENTS_DIR"] = str(stop_tmp)
    s_rid = "test-stop-run"
    (stop_tmp / s_rid).mkdir()
    save(stop_tmp / s_rid, {"id": s_rid, "name": s_rid, "task": "test", "cwd": str(stop_tmp), "who": "claude",
                            "status": "running", "pid": 9999999, "plan": [{"step": "step 1", "status": "in_progress"}]})
    stop(s_rid, force=True)
    stopped_st = load(stop_tmp / s_rid)
    check("agent-force-stop", stopped_st["status"] == "stopped" and "force" in stopped_st.get("now", "")
          and stopped_st["pid"] is None and stopped_st["plan"][0]["status"] == "left")

    # Provider handoff checks:
    # 1. Auto-handoff on provider failure (codex quota fail -> grok succeeds and receives handoff context)
    ho_tmp = Path(tempfile.mkdtemp(prefix="ragnarok-agent-handoff-"))
    grok_ho = bin_dir / "grok-handoff"
    grok_ho.write_text(r"""#!/bin/bash
D="$RAGNAROK_AGENTS_DIR/$RAGNAROK_AGENT_RUN"
printf '%s' "$*" > "$D/grok-args.txt"
printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-ho","model":"grok-4.7"}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"w1","name":"Read","input":{"file_path":"x"}}]}}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"DONE: finished after handoff\nLEFT: nothing"}]}}'
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: finished after handoff\nLEFT: nothing","total_cost_usd":0.02,"num_turns":1,"session_id":"sess-grok-ho"}'
""")
    os.chmod(grok_ho, 0o755)
    os.environ.update(RAGNAROK_AGENTS_DIR=str(ho_tmp), RAGNAROK_AGENT_NO_RECEIPT="1",
                      RAGNAROK_AGENT_CODEX=str(codex_fail), RAGNAROK_AGENT_GROK=str(grok_ho),
                      RAGNAROK_AGENT_CLAUDE=str(claude))
    ho_rid = "test-auto-handoff"
    (ho_tmp / ho_rid).mkdir()
    save(ho_tmp / ho_rid, {"id": ho_rid, "name": ho_rid, "task": "relay task across providers", "cwd": str(ho_tmp),
                           "who": "codex", "started_who": "codex", "handoff_chain": ["grok"],
                           "handoffs": [], "mode": "plain", "status": "starting", "started": now(), "ended": None,
                           "now": "", "plan": [{"step": "step one", "status": "in_progress"}], "actions": [],
                           "tools": 0, "errors": 0, "hook_blocks": 0, "remark": "", "final": "", "cost_usd": None,
                           "turns": None, "session": None, "pid": None})
    run(ho_rid)
    ho_st = load(ho_tmp / ho_rid)
    grok_args = (ho_tmp / ho_rid / "grok-args.txt").read_text() if (ho_tmp / ho_rid / "grok-args.txt").exists() else ""
    check("auto-handoff-on-fail", ho_st["status"] == "done" and ho_st["who"] == "grok"
          and ho_st["started_who"] == "codex" and len(ho_st.get("handoffs") or []) == 1
          and ho_st["handoffs"][0]["from"] == "codex" and ho_st["handoffs"][0]["to"] == "grok"
          and "quota" in ho_st["handoffs"][0]["reason"].lower()
          and "HANDOFF FROM CODEX" in grok_args and "relay task across providers" in grok_args
          and "codex->grok" in run_summary(ho_st))

    # 2. Auto-handoff when a provider finishes but leaves non-human work in LEFT: or unfinished plan steps
    grok_partial = bin_dir / "grok-partial"
    grok_partial.write_text(r"""#!/bin/bash
printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-part","model":"grok-4.7"}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"todo_write","input":{"merge":false,"todos":[{"id":"1","content":"part 1","status":"completed"},{"id":"2","content":"part 2","status":"pending"}]}},{"type":"text","text":"DONE: completed part 1\nLEFT: implement part 2 in module.py"}]}}'
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: completed part 1\nLEFT: implement part 2 in module.py","total_cost_usd":0.01,"num_turns":1,"session_id":"sess-grok-part"}'
""")
    os.chmod(grok_partial, 0o755)
    os.environ["RAGNAROK_AGENT_GROK"] = str(grok_partial)
    hp_rid = "test-unfinished-handoff"
    (ho_tmp / hp_rid).mkdir()
    save(ho_tmp / hp_rid, {"id": hp_rid, "name": hp_rid, "task": "two part task", "cwd": str(ho_tmp),
                           "who": "grok", "started_who": "grok", "handoff_chain": ["claude"],
                           "handoffs": [], "mode": "plain", "status": "starting", "started": now(), "ended": None,
                           "now": "", "plan": [], "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0,
                           "remark": "", "final": "", "cost_usd": None, "turns": None, "session": None, "pid": None})
    run(hp_rid)
    hp_st = load(ho_tmp / hp_rid)
    check("auto-handoff-unfinished-steps", hp_st["status"] == "done" and hp_st["who"] == "claude"
          and len(hp_st.get("handoffs") or []) == 1 and hp_st["handoffs"][0]["from"] == "grok"
          and hp_st["handoffs"][0]["to"] == "claude" and abs((hp_st.get("cost_usd") or 0) - 1.51) < 1e-6)

    # 3. Human-only LEFT: ("Physical touch on YubiKey") must NOT hand off to another AI
    grok_human = bin_dir / "grok-human"
    grok_human.write_text(r"""#!/bin/bash
printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-hum","model":"grok-4.7"}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"DONE: code verified\nLEFT: Physical touch on YubiKey or Touch ID"}]}}'
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: code verified\nLEFT: Physical touch on YubiKey or Touch ID","total_cost_usd":0.01,"num_turns":1,"session_id":"sess-grok-hum"}'
""")
    os.chmod(grok_human, 0o755)
    os.environ["RAGNAROK_AGENT_GROK"] = str(grok_human)
    hh_rid = "test-human-no-handoff"
    (ho_tmp / hh_rid).mkdir()
    save(ho_tmp / hh_rid, {"id": hh_rid, "name": hh_rid, "task": "verify hardware key", "cwd": str(ho_tmp),
                           "who": "grok", "started_who": "grok", "handoff_chain": ["claude"],
                           "handoffs": [], "mode": "plain", "status": "starting", "started": now(), "ended": None,
                           "now": "", "plan": [], "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0,
                           "remark": "", "final": "", "cost_usd": None, "turns": None, "session": None, "pid": None})
    run(hh_rid)
    hh_st = load(ho_tmp / hh_rid)
    check("handoff-preserves-human-stop", hh_st["status"] == "done" and hh_st["who"] == "grok"
          and len(hh_st.get("handoffs") or []) == 0)

    # 4. Manual `ragnarok-agent handoff` command creates a linked continuation run with carried-over state
    m_new_id = handoff([hh_rid, "--who", "claude", "--no-handoff", "continue after hardware touch"], spawn=False)
    m_new_st = load(ho_tmp / m_new_id)
    hh_after = load(ho_tmp / hh_rid)
    check("manual-handoff-cmd", m_new_st and m_new_st["who"] == "claude"
          and m_new_st["handoff_from"] == hh_rid and hh_after.get("handed_off_to") == m_new_id
          and m_new_st["handoff_chain"] == [] and len(m_new_st.get("handoffs") or []) == 1
          and (ho_tmp / m_new_id / "handoff_prompt.txt").exists())

    # 5. Gjallarhorn records an unsupported claim. It does not start another leg.
    horn_bin = bin_dir / "gjallarhorn-fake"
    horn_bin.write_text(r"""#!/usr/bin/env python3
import json, sys
inp = json.load(sys.stdin)
if "unverified-claim" in inp.get("answer", ""):
    print(json.dumps({"unsupported": [{"claim": "unverified-claim", "why": "no tool output backs this"}]}))
else:
    print(json.dumps({"unsupported": []}))
""")
    os.chmod(horn_bin, 0o755)
    grok_horn = bin_dir / "grok-horn"
    grok_horn.write_text(r"""#!/bin/bash
if [[ "$*" == *"Alexus Local Referee"* ]]; then
  printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-horn","model":"grok-4.7"}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"w1","name":"Read","input":{"file_path":"x"}}]}}'
  printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: verified and corrected claim after Gjallarhorn check\nLEFT: nothing","total_cost_usd":0.01,"num_turns":1,"session_id":"sess-grok-horn"}'
else
  printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-horn","model":"grok-4.7"}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"w1","name":"Read","input":{"file_path":"x"}}]}}'
  printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: made an unverified-claim about a file without checking\nLEFT: nothing","total_cost_usd":0.01,"num_turns":1,"session_id":"sess-grok-horn"}'
fi
""")
    os.chmod(grok_horn, 0o755)
    os.environ["RAGNAROK_AGENT_GJALLARHORN"] = str(horn_bin)
    os.environ["RAGNAROK_AGENT_GROK"] = str(grok_horn)
    gh_rid = "test-gjallarhorn"
    (ho_tmp / gh_rid).mkdir()
    save(ho_tmp / gh_rid, {"id": gh_rid, "name": gh_rid, "task": "test gjallarhorn", "cwd": str(ho_tmp),
                           "who": "grok", "started_who": "grok", "handoff_chain": [], "handoffs": [],
                           "mode": "plain", "status": "starting", "started": now(), "ended": None,
                           "now": "", "plan": [], "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0,
                           "remark": "", "final": "", "cost_usd": None, "turns": None, "session": None, "pid": None})
    run(gh_rid)
    os.environ.pop("RAGNAROK_AGENT_GJALLARHORN", None)
    gh_st = load(ho_tmp / gh_rid)
    check("gjallarhorn-referee", gh_st["status"] == "done" and gh_st["hook_blocks"] == 1
          and "unverified-claim" in gh_st["final"]
          and "corrected claim after Gjallarhorn" not in gh_st["final"]
          and any(a.get("kind") == "hook" and "📯 [Gjallarhorn]" in (a.get("what") or "") for a in gh_st["actions"]))

    # 6. Human helper intervention & resume:
    #    - A LEFT line that names a person or an account pauses. A bare question does not.
    #    - Human answers via `ragnarok-agent resume <id> "Use port 5433"` -> resumes session, passes answer, completes run
    grok_ask = bin_dir / "grok-ask"
    grok_ask.write_text(r"""#!/bin/bash
D="$RAGNAROK_AGENTS_DIR/$RAGNAROK_AGENT_RUN"
if [[ "$*" == *"--resume"* ]]; then
  printf '%s' "$*" > "$D/resume-args.txt"
  printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-ask","model":"grok-4.7"}'
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t2","name":"todo_write","input":{"merge":true,"todos":[{"id":"1","status":"completed"},{"id":"2","status":"completed"}]}},{"type":"text","text":"DONE: bound service to port 5433 as requested\nLEFT: nothing"}]}}'
  printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: bound service to port 5433 as requested\nLEFT: nothing","total_cost_usd":0.02,"num_turns":1,"session_id":"sess-grok-ask"}'
else
  printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-ask","model":"grok-4.7"}'
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"todo_write","input":{"merge":false,"todos":[{"id":"1","content":"inspect config","status":"completed"},{"id":"2","content":"bind port","status":"in_progress"}]}},{"type":"text","text":"DONE: inspected config\nLEFT: Which port should I bind (staging 5433 or prod 5432)? The owner has to approve the account."}]}}'
  printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: inspected config\nLEFT: Which port should I bind (staging 5433 or prod 5432)? The owner has to approve the account.","total_cost_usd":0.01,"num_turns":1,"session_id":"sess-grok-ask"}'
fi
""")
    os.chmod(grok_ask, 0o755)
    os.environ["RAGNAROK_AGENT_GROK"] = str(grok_ask)
    hr_rid = "test-human-resume"
    (ho_tmp / hr_rid).mkdir()
    save(ho_tmp / hr_rid, {"id": hr_rid, "name": hr_rid, "task": "configure service port", "cwd": str(ho_tmp),
                           "who": "grok", "started_who": "grok", "handoff_chain": ["claude"], "handoffs": [],
                           "mode": "plain", "status": "starting", "started": now(), "ended": None,
                           "now": "", "plan": [], "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0,
                           "remark": "", "final": "", "cost_usd": None, "turns": None, "session": None, "pid": None})
    run(hr_rid)
    hr_paused = load(ho_tmp / hr_rid)
    check("human-request-detected", hr_paused["status"] == "done" and hr_paused["verdict"] == "needs you"
          and "Which port should I bind" in (hr_paused.get("human_request") or "")
          and len(hr_paused.get("handoffs") or []) == 0
          and hr_paused["plan"][1]["status"] == "left")
    resume_run([hr_rid, "Use staging port 5433"], spawn=False)
    run(hr_rid)
    hr_done = load(ho_tmp / hr_rid)
    res_args = (ho_tmp / hr_rid / "resume-args.txt").read_text() if (ho_tmp / hr_rid / "resume-args.txt").exists() else ""
    check("human-resume-completed", hr_done["status"] == "done" and hr_done.get("verdict") is None
          and hr_done.get("human_request") is None
          and "port 5433" in (hr_done.get("final") or "")
          and "--resume sess-grok-ask" in res_args and "Use staging port 5433" in res_args
          and len(hr_done.get("human_replies") or []) == 1
          and hr_done["human_replies"][0]["reply"] == "Use staging port 5433"
          and all(s["status"] == "completed" for s in hr_done["plan"])
          and abs((hr_done.get("cost_usd") or 0) - 0.03) < 1e-6)

    # 7. Proved mode human check approval on resume (`verify: HUMAN` becomes ok=True -> verdict="proved")
    os.environ.update(RAGNAROK_AGENTS_DIR=str(ptmp), RAGNAROK_AGENT_CLAUDE=str(fake))
    resume_run(["p-good", "--approve-human", "Looks great, approved"], spawn=False)
    run("p-good")
    ps_resumed = load(ptmp / "p-good")
    check("human-resume-proved", ps_resumed["verdict"] == "proved" and ps_resumed["status"] == "done"
          and ps_resumed.get("human_request") is None
          and any(c["claim"] == "Owner likes it" and c["ok"] is True for c in (ps_resumed.get("checks") or [])))

    codex_res_cmd = launch_cmd({"who": "codex", "task": "t", "cwd": "/tmp/proj", "model": "gpt-6.1-sol"},
                               prompt="human answer", resume="thread-123")
    check("codex-resume-flags", "resume" in codex_res_cmd
          and codex_res_cmd[codex_res_cmd.index("resume") + 1] == "thread-123"
          and codex_res_cmd[codex_res_cmd.index("resume") + 2] == "human answer")

    # 8. Multi-hop handoff context preservation (Leg 1 substantive -> Leg 2 short crash -> Leg 3 gets both)
    mh_prompt = build_handoff_prompt({
        "task": "build and wire parser",
        "cwd": str(ho_tmp),
        "plan": [{"step": "build parser", "status": "completed"}, {"step": "wire CLI", "status": "pending"}],
        "handoffs": [
            {"from": "claude", "to": "codex", "reason": "unfinished work left: wire CLI", "summary": "DONE: built parser in parser.py"},
            {"from": "codex", "to": "grok", "reason": "failed: quota exhausted", "summary": "quota exhausted"},
        ],
        "actions": [{"kind": "tool", "tool": "Write", "what": "parser.py", "result": "wrote 120 lines"}],
        "final": "quota exhausted",
        "last_good_final": "DONE: built parser in parser.py with full AST support\nLEFT: wire CLI",
    }, "codex", "failed: quota exhausted")
    check("multi-hop-handoff-context",
          "PRIOR HANDOFF CHAIN HISTORY:" in mh_prompt
          and "Leg 1 (claude -> codex)" in mh_prompt
          and "EARLIER SUBSTANTIVE PROVIDER OUTPUT:" in mh_prompt
          and "full AST support" in mh_prompt
          and "RECENT TOOL ACTIONS IN THIS RUN:" in mh_prompt
          and "[Write] parser.py" in mh_prompt)


    # 2026-11-07: "done" must mean something, on every runner.
    nw_tmp = Path(tempfile.mkdtemp(prefix="ragnarok-agent-nowork-"))
    codex_empty = bin_dir / "codex-empty"
    codex_empty.write_text(r"""#!/bin/bash
printf '%s\n' '{"type":"thread.started","thread_id":"t-empty"}'
printf '%s\n' '{"type":"item.completed","item":{"id":"m","type":"agent_message","text":"{\"name\":\"fake_tool\"}"}}'
printf '%s\n' '{"type":"turn.completed"}'
""")
    os.chmod(codex_empty, 0o755)
    grok_works = bin_dir / "grok-works"
    grok_works.write_text(r"""#!/bin/bash
printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-w","model":"grok-4.7"}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"w1","name":"Read","input":{"file_path":"x"}}]}}'
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: took over the job\nLEFT: nothing","num_turns":1,"session_id":"sess-w"}'
""")
    os.chmod(grok_works, 0o755)
    os.environ.update(RAGNAROK_AGENTS_DIR=str(nw_tmp), RAGNAROK_AGENT_NO_RECEIPT="1",
                      RAGNAROK_AGENT_CODEX=str(codex_empty), RAGNAROK_AGENT_GROK=str(grok_works))
    def nw_run(rid, who, chain, mode):
        (nw_tmp / rid).mkdir()
        save(nw_tmp / rid, {"id": rid, "name": rid, "task": "make a change", "cwd": str(nw_tmp), "who": who,
                            "started_who": who, "handoff_chain": chain, "handoffs": [], "mode": mode,
                            "status": "starting", "started": now(), "ended": None, "now": "", "plan": [],
                            "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0, "remark": "", "final": "",
                            "cost_usd": None, "turns": None, "session": None, "pid": None})
        run(rid)
        return load(nw_tmp / rid)
    e1 = nw_run("no-work-fails", "codex", [], "plain")
    check("no-work-is-not-done", e1["status"] == "failed" and "did no work" in e1["final"] and e1["tools"] == 0)
    e2 = nw_run("no-work-hands-off", "codex", ["grok"], "plain")
    check("no-work-hands-off", e2["status"] == "done" and e2["who"] == "grok"
          and "did no work" in e2["handoffs"][0]["reason"])
    pcmd = {w: " ".join(launch_cmd({"who": w, "task": "t", "cwd": "/tmp/proj", "_dir": "/tmp/run1", "id": "r",
                                    "mode": "proved"})) for w in ("claude", "grok", "muse", "codex")}
    check("proof-guide-every-runner", all("/tmp/run1/checklist.md" in c for c in pcmd.values())
          and "writable_roots" in pcmd["codex"] and "--add-dir" not in pcmd["grok"])
    mt = {"actions": [], "plan": [], "tools": 0, "errors": 0, "now": ""}
