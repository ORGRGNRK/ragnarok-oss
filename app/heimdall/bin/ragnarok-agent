          and any(a.get("tool") == "read_file" and a.get("result") == "error" for a in ms["actions"]))
    codex_fail = bin_dir / "codex-fail"
    codex_fail.write_text(r"""#!/bin/bash
printf '%s\n' '{"type":"thread.started","thread_id":"t-fail"}'
