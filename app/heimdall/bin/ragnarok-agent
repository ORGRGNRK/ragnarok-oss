    os.environ["RAGNAROK_AGENT_CRITICS"] = "claude"   # fake CLIs only: no check may reach a real AI
    import tempfile
    ok = True

    def check(name, cond):
        nonlocal ok
        print(("ok  " if cond else "FAIL") + " " + name)
        if not cond:
            ok = False

