#!/bin/bash
# ragnarok-pipe-money-setup — one time: makes the Money tab's own receipt pipeline on Alexus and connects the app to it.
#   - a separate copy of ragnarok-pipe on Alexus: web app on port 8449, its own database on 127.0.0.1:5545, its own photos
#     and login (deploy/new-instance.sh in ~/Developer/ragnarok-pipe, sent over ssh; Alexus's checkout isn't changed)
#   - its login is made here and kept in this Mac's keychain (service ragnarok-pipe-money, account ragnarok);
#     the Money tab's Receipts page reads it from there. Nothing secret is printed.
# Run it yourself: it changes things on Alexus (as ALEXUS_USER from ~/.ragnarok/local.conf).
# Safe to run again after a failure: it reuses the saved login, and the Alexus script refuses to touch a finished copy.
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
. "$REPO/bin/local-config.sh"
PIPE="${PIPE_REPO:-$HOME/Developer/ragnarok-pipe}"
SVC=ragnarok-pipe-money WEB_USER=ragnarok NAME=money APP_PORT=8449 DB_PORT=5545
[ -f "$PIPE/deploy/new-instance.sh" ] || { echo "can't find $PIPE/deploy/new-instance.sh"; exit 1; }

if PW=$(security find-generic-password -s "$SVC" -a "$WEB_USER" -w 2>/dev/null); then
  echo "using the login already saved in the keychain ($SVC)"
else
  PW=$(python3 -c 'import secrets;print(secrets.token_urlsafe(24))')
  security add-generic-password -U -s "$SVC" -a "$WEB_USER" -l "Ragnarok receipts (Money tab)" -w "$PW"
  echo "saved a new login in the keychain ($SVC)"
fi

echo "setting up the money receipt pipeline on $ALEXUS_SSH (port $APP_PORT)…"
ssh -o BatchMode=yes -o ConnectTimeout=10 "$ALEXUS_SSH" "bash -s -- $NAME $APP_PORT $DB_PORT" \
  < <(printf 'export WEB_PW=%q WEB_USER=%q\n' "$PW" "$WEB_USER"; cat "$PIPE/deploy/new-instance.sh")

if out=$(printf 'user = "%s:%s"\n' "$WEB_USER" "$PW" | curl -sf -m 8 -K - "http://$ALEXUS_HOST:$APP_PORT/api/documents?limit=1"); then
  echo "this Mac can reach it with the saved login: http://$ALEXUS_HOST:$APP_PORT (Money tab → Receipts)"
else
  echo "set up on Alexus, but this Mac couldn't log in to http://$ALEXUS_HOST:$APP_PORT yet"; exit 1
fi
