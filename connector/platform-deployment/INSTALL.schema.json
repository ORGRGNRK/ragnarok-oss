{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secure-mcp-platform:install-guide:1.0.0",
  "title": "Machine-followable install guide",
  "type": "object",
  "required": ["schema_version", "name", "description", "safety", "prerequisites", "inputs", "steps", "post_install_verification", "uninstall"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "how_to_follow": { "type": "array", "items": { "type": "string" } },
    "safety": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "prerequisites": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "what", "check", "expect", "install_hint", "requires_human_to_fix"],
        "properties": {
          "id": { "$ref": "#/$defs/id" }, "what": { "type": "string" }, "check": { "type": "string" },
          "expect": { "$ref": "#/$defs/expect" }, "install_hint": { "type": "string" },
          "requires_human_to_fix": { "type": "boolean" }, "optional": { "type": "boolean" }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "env", "default", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "default": { "type": "string" },
          "description": { "type": "string" }
        },
        "not": { "properties": { "env": { "pattern": "(PASSWORD|SECRET|TOKEN)" } }, "required": ["env"] }
      }
    },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "post_install_verification": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
    "uninstall": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "expect": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "exit_code": { "type": "integer" },
        "output_matches": { "type": "string", "description": "Regex (JavaScript/PCRE-compatible) over stdout+stderr" }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "why", "cwd", "run", "expect", "verify", "on_failure", "requires_human"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "why": { "type": "string" },
        "cwd": { "type": "string" },
        "when": { "type": "string", "description": "bash condition; non-zero exit = skip the step" },
        "run": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "expect": { "$ref": "#/$defs/expect" },
        "verify": {
          "type": "object", "additionalProperties": false, "required": ["run", "expect"],
          "properties": { "run": { "type": "string" }, "expect": { "$ref": "#/$defs/expect" } }
        },
        "on_failure": {
          "type": "object", "additionalProperties": false, "required": ["diagnosis", "rollback"],
          "properties": { "diagnosis": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "rollback": { "type": "string" } }
        },
        "requires_human": { "type": "boolean" },
        "human_prompt": { "type": "string" },
        "optional": { "type": "boolean" }
      },
      "if": { "properties": { "requires_human": { "const": true } } },
      "then": { "required": ["human_prompt"] }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "cwd", "run", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "cwd": { "type": "string" },
        "when": { "type": "string" }, "run": { "type": "string" }, "expect": { "$ref": "#/$defs/expect" },
        "requires_human": { "type": "boolean" }, "human_prompt": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1 }, "note": { "type": "string" }
      }
    }
  }
}
