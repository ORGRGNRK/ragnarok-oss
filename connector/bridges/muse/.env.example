# Copy to .env (gitignored) and chmod 600. Values are never printed.
# --- Muse (Meta Model API) ---
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3
MUSE_EFFORT=low                  # minimal / low / medium / high
MUSE_MAX_COMPLETION_TOKENS=4096  # per Muse reply, reasoning included
MUSE_SESSION_USD=0.50            # bridge stops a session past this estimate
# --- Yggdrasil MCP (remote, read token) ---
YGG_MCP_URL=https://mcp-server.example.com/mcp
YGG_MCP_TOKEN_FILE=~/.config/ragnarok/ygg-mcp-read-token
# or fetch it from Alexus each run instead of keeping a copy on the Mac:
# YGG_MCP_TOKEN_CMD=ssh -o BatchMode=yes grok@alexus sudo -n -u yggdrasil cat ~/Yggdrasil-v2/secrets/mcp-http-token
# --- or stdio instead of HTTP (any command that speaks MCP on stdio) ---
# YGG_MCP_COMMAND=
YGG_ACTOR=Muse
