acceptance ::= "{" space acceptance-checks-kv "," space acceptance-expected-result-kv "}" space
acceptance-checks ::= "[" space acceptance-checks-item ("," space acceptance-checks-item){0,5} "]" space
acceptance-checks-item ::= "{" space acceptance-checks-item-claim-kv "," space acceptance-checks-item-verify-kv ( "," space ( acceptance-checks-item-expect-kv ) )? "}" space
acceptance-checks-item-claim ::= "\"" ([^\n:"\\]+) "\"" space
acceptance-checks-item-claim-kv ::= "\"claim\"" space ":" space acceptance-checks-item-claim
acceptance-checks-item-expect ::= "\"" char{1,120} "\"" space
acceptance-checks-item-expect-kv ::= "\"expect\"" space ":" space acceptance-checks-item-expect
acceptance-checks-item-verify ::= "\"" char{4,300} "\"" space
acceptance-checks-item-verify-kv ::= "\"verify\"" space ":" space acceptance-checks-item-verify
acceptance-checks-kv ::= "\"checks\"" space ":" space acceptance-checks
acceptance-expected-result ::= "\"" char{5,200} "\"" space
acceptance-expected-result-kv ::= "\"expected_result\"" space ":" space acceptance-expected-result
acceptance-kv ::= "\"acceptance\"" space ":" space acceptance
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
constraints ::= "{" space constraints-network-kv "," space constraints-secrets-kv "," space constraints-write-scope-kv ( "," space ( constraints-notes-kv ) )? "}" space
constraints-kv ::= "\"constraints\"" space ":" space constraints
constraints-network ::= ("\"none\"" | "\"localhost_only\"" | "\"public_read_only\"") space
constraints-network-kv ::= "\"network\"" space ":" space constraints-network
constraints-notes ::= "[" space (constraints-notes-item ("," space constraints-notes-item){0,4})? "]" space
constraints-notes-item ::= "\"" char{0,160} "\"" space
constraints-notes-kv ::= "\"notes\"" space ":" space constraints-notes
constraints-secrets ::= "\"none\"" space
constraints-secrets-kv ::= "\"secrets\"" space ":" space constraints-secrets
constraints-write-scope ::= "[" space constraints-write-scope-item ("," space constraints-write-scope-item){0,5} "]" space
constraints-write-scope-item ::= "\"" ([A-Za-z0-9._] constraints-write-scope-item-1{0,150}) "\"" space
constraints-write-scope-item-1 ::= [A-Za-z0-9._/-]
constraints-write-scope-kv ::= "\"write_scope\"" space ":" space constraints-write-scope
depends-on ::= "[" space (depends-on-item ("," space depends-on-item){0,4})? "]" space
depends-on-item ::= "\"" ([a-z0-9] depends-on-item-1{2,59}) "\"" space
depends-on-item-1 ::= [a-z0-9-]
depends-on-kv ::= "\"depends_on\"" space ":" space depends-on
files-to-touch ::= "[" space files-to-touch-item ("," space files-to-touch-item){0,5} "]" space
files-to-touch-item ::= "{" space files-to-touch-item-path-kv "," space files-to-touch-item-action-kv ( "," space ( files-to-touch-item-why-kv ) )? "}" space
files-to-touch-item-action ::= ("\"create\"" | "\"edit\"" | "\"read\"") space
files-to-touch-item-action-kv ::= "\"action\"" space ":" space files-to-touch-item-action
files-to-touch-item-path ::= "\"" ([A-Za-z0-9._] files-to-touch-item-path-1{0,150}) "\"" space
files-to-touch-item-path-1 ::= [A-Za-z0-9._/-]
files-to-touch-item-path-kv ::= "\"path\"" space ":" space files-to-touch-item-path
files-to-touch-item-why ::= "\"" char{0,120} "\"" space
files-to-touch-item-why-kv ::= "\"why\"" space ":" space files-to-touch-item-why
files-to-touch-kv ::= "\"files_to_touch\"" space ":" space files-to-touch
goal ::= "\"" char{10,200} "\"" space
goal-kv ::= "\"goal\"" space ":" space goal
id ::= "\"" ([a-z0-9] id-1{2,59}) "\"" space
id-1 ::= [a-z0-9-]
id-kv ::= "\"id\"" space ":" space id
limits ::= "{" space limits-max-files-changed-kv "," space limits-max-lines-changed-kv ( "," space ( limits-timeout-s-kv ) )? "}" space
limits-kv ::= "\"limits\"" space ":" space limits
limits-max-files-changed ::= ([1-5]) space
limits-max-files-changed-kv ::= "\"max_files_changed\"" space ":" space limits-max-files-changed
limits-max-lines-changed ::= ([1-9] | ([1-8] [0-9] | [9] [0-9]) | ([1-2] [0-9]{2} | [3] "00")) space
limits-max-lines-changed-kv ::= "\"max_lines_changed\"" space ":" space limits-max-lines-changed
limits-timeout-s ::= (([3-8] [0-9] | [9] [0-9]) | ([1-8] [0-9]{2} | [9] ([0-8] [0-9] | [9] [0-9])) | "1" ([0-7] [0-9]{2} | [8] "00")) space
limits-timeout-s-kv ::= "\"timeout_s\"" space ":" space limits-timeout-s
null ::= "null" space
project ::= "\"" ([A-Za-z0-9] project-1{0,39}) "\"" space
project-1 ::= [A-Za-z0-9._-]
project-kv ::= "\"project\"" space ":" space project
provenance ::= "{" space provenance-proposed-by-kv "," space provenance-source-kv "," space provenance-proposed-at-kv ( "," space ( provenance-approved-by-kv provenance-approved-by-rest | provenance-ask-kv ) )? "}" space
provenance-approved-by ::= provenance-approved-by-0 | null
provenance-approved-by-0 ::= "\"" char{0,40} "\"" space
provenance-approved-by-kv ::= "\"approved_by\"" space ":" space provenance-approved-by
provenance-approved-by-rest ::= ( "," space provenance-ask-kv )?
provenance-ask ::= "\"" char{0,300} "\"" space
provenance-ask-kv ::= "\"ask\"" space ":" space provenance-ask
provenance-kv ::= "\"provenance\"" space ":" space provenance
provenance-proposed-at ::= "\"" (provenance-proposed-at-1{4,4} "-" provenance-proposed-at-1{2,2} "-" provenance-proposed-at-1{2,2} "T" provenance-proposed-at-1{2,2} ":" provenance-proposed-at-1{2,2} ":" provenance-proposed-at-1{2,2} ([+-] provenance-proposed-at-1{2,2} ":" provenance-proposed-at-1{2,2} | "Z")) "\"" space
provenance-proposed-at-1 ::= [0-9]
provenance-proposed-at-kv ::= "\"proposed_at\"" space ":" space provenance-proposed-at
provenance-proposed-by ::= "\"" char{2,80} "\"" space
provenance-proposed-by-kv ::= "\"proposed_by\"" space ":" space provenance-proposed-by
provenance-source ::= ("\"planner\"" | "\"finding\"" | "\"intent\"" | "\"chris\"" | "\"session\"") space
provenance-source-kv ::= "\"source\"" space ":" space provenance-source
root ::= "{" space schema-version-kv "," space id-kv "," space title-kv "," space goal-kv "," space project-kv "," space root-kv "," space files-to-touch-kv "," space steps-kv "," space constraints-kv "," space acceptance-kv "," space limits-kv "," space depends-on-kv "," space status-kv "," space provenance-kv "}" space
root- ::= "\"" ("/" root--1{1,200}) "\"" space
root--1 ::= [A-Za-z0-9._/-]
root-kv ::= "\"root\"" space ":" space root-
schema-version ::= "\"conveyor-task/0.1\"" space
schema-version-kv ::= "\"schema_version\"" space ":" space schema-version
space ::= | " " | "\n"{1,2} [ \t]{0,20}
status ::= ("\"proposed\"" | "\"queue\"" | "\"running\"" | "\"verify\"" | "\"human\"" | "\"done\"" | "\"failed\"") space
status-kv ::= "\"status\"" space ":" space status
steps ::= "[" space steps-item ("," space steps-item){0,5} "]" space
steps-item ::= "\"" char{5,160} "\"" space
steps-kv ::= "\"steps\"" space ":" space steps
title ::= "\"" char{5,80} "\"" space
title-kv ::= "\"title\"" space ":" space title
