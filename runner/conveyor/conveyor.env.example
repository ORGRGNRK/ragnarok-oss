# conveyor.env.example -- copy to conveyor.env (not tracked by git) and edit.
# Every line is optional; the value shown is the default the scripts use when
# the line is absent. ./conveyor reads conveyor.env (or $CONVEYOR_CONFIG);
# anything already set in the environment wins. Plain shell: KEY=value, quote
# values with spaces. Keep real keys out of this file if you can: put the key
# in your shell profile or keychain and name it with *_KEY_ENV below.

# --- who does what (claude | codex | gemini | grok | local | api) -----------
# CONVEYOR_PLANNER_SEAT=claude
# CONVEYOR_CRITIC_SEAT=grok            # default: grok, or claude if the planner is grok
# CONVEYOR_DRIVER_SEAT=claude          # the coder. "local" = your own model server
# CONVEYOR_VERIFIER_SEAT=claude
# CONVEYOR_ESCALATE_SEAT=              # empty = a stuck step asks you

# --- planning ----------------------------------------------------------------
# CONVEYOR_PLAN_FORMAT=json            # json (schema-checked task) or markdown (old checklist)
# CONVEYOR_PLAN_ROUNDS=2               # planner+critic rounds before it goes to human/
# CONVEYOR_PLAN_JSON_RETRIES=2         # re-asks per round when the JSON fails the validator
# CONVEYOR_JSON_NATIVE_SCHEMA=1        # pass --json-schema to claude/grok (0 = prompt + extract only)
# CONVEYOR_JSON_ALLOW_HUMAN=0          # 1 = allow the schema's one HUMAN check (then the task waits on you)
# CONVEYOR_JSON_ALLOWED_ROOTS=         # e.g. /Users/me/code:/srv/projects ; empty = any absolute path
# CONVEYOR_PLAN_TIMEOUT=900

# --- the "api" seat: any OpenAI-compatible server (planner/critic only) ------
# Works with llama-server, Ollama (/v1), LM Studio, vLLM, OpenRouter, OpenAI, xAI.
# CONVEYOR_API_BASE_URL=               # e.g. http://127.0.0.1:8080/v1
# CONVEYOR_API_MODEL=
# CONVEYOR_API_KEY_ENV=CONVEYOR_API_KEY  # NAME of the variable that holds the key (optional)
# CONVEYOR_API_RESPONSE_FORMAT=json_schema   # json_schema | json_object | none
# CONVEYOR_API_STRICT=0                # 1 = OpenAI strict mode (needs every field required; this schema is not)
# CONVEYOR_API_TIMEOUT=600
# Different providers for the two jobs: the same names with PLANNER_/CRITIC_, e.g.
# CONVEYOR_PLANNER_API_BASE_URL= / CONVEYOR_PLANNER_API_MODEL=
# CONVEYOR_CRITIC_API_BASE_URL=  / CONVEYOR_CRITIC_API_MODEL=

# --- the "local" seat (the coder on your own model server) -------------------
# CONVEYOR_LOCAL_API=openai
# CONVEYOR_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
# CONVEYOR_LOCAL_MODEL=conveyor-general
# CONVEYOR_LOCAL_API_KEY=              # optional

# --- CLI locations (found on PATH by ./conveyor when unset) -------------------
# CONVEYOR_CLAUDE= CONVEYOR_CODEX= CONVEYOR_GEMINI= CONVEYOR_GROK=
