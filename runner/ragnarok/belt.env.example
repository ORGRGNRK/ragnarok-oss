# Copy to belt.env (git ignores *.env) to change a setting. RUNNER_* lines only; the environment wins.
# The model server must be on this Mac or the local network (the model door refuses anything else).
RUNNER_OLLAMA_HOST=http://alexus:11434
RUNNER_CODER_MODEL=qwen2.5-coder:7b
RUNNER_PLANNER_MODEL=qwen2.5-coder:7b
RUNNER_CRITIC_MODEL=llama3.2:3b
RUNNER_PROJECT=ragnarok-belt
# RUNNER_BELT_DIR=          default runner/.belt (the trays)
# RUNNER_WORK_DIR=          default runner/.work (the only Mac folder the AI can write to)
RUNNER_DOOR_PORT=58190
RUNNER_TASK_TIMEOUT=1800
# RUNNER_HUMAN=             name on a person's approve/accept/reject receipts (default: your Mac login)
