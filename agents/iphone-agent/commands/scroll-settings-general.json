{
  "schemaVersion": "0.1",
  "version": "1.0.0",
  "id": "com.yggdrasil.iphone.scroll-settings-general",
  "name": "Scroll Settings General",
  "description": "Open General, reset its remembered scroll position, swipe upward, and verify lower rows became visible.",
  "safety": { "risk": "reversible" },
  "steps": [
    {
      "id": "open-settings-general",
      "action": "openApp",
      "app": { "name": "General" },
      "expect": {
        "all": [{ "app": { "name": "Settings" } }, { "screenText": "General" }]
      }
    },
    {
      "id": "reset-general-toward-top-1",
      "action": "swipe",
      "direction": "down",
      "from": { "x": 0.5, "y": 0.22 },
      "distance": 0.65
    },
    {
      "id": "reset-general-toward-top-2",
      "action": "swipe",
      "direction": "down",
      "from": { "x": 0.5, "y": 0.22 },
      "distance": 0.65,
      "expect": { "screenText": "About" }
    },
    {
      "id": "scroll-general-down",
      "action": "swipe",
      "direction": "up",
      "from": { "x": 0.5, "y": 0.78 },
      "distance": 0.55,
      "expect": { "screenText": "Trackpad & Mouse" }
    }
  ],
  "postconditions": [
    {
      "all": [
        { "app": { "name": "Settings" } },
        { "screenText": "Trackpad & Mouse" }
      ]
    }
  ]
}
