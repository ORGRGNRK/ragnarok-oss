{
  "schemaVersion": "0.1",
  "version": "1.0.0",
  "id": "com.yggdrasil.iphone.capture-about-top-bottom",
  "name": "Capture iPhone About Top and Bottom",
  "description": "Open About through Spotlight, save the top of the page, scroll to the verified bottom, and save the bottom.",
  "safety": { "risk": "reversible" },
  "steps": [
    {
      "id": "open-about",
      "action": "openApp",
      "app": { "name": "About" },
      "expect": {
        "all": [{ "app": { "name": "Settings" } }, { "screenText": "About" }]
      }
    },
    {
      "id": "reset-about-toward-top-1",
      "action": "swipe",
      "direction": "down",
      "from": { "x": 0.5, "y": 0.22 },
      "distance": 0.65
    },
    {
      "id": "reset-about-toward-top-2",
      "action": "swipe",
      "direction": "down",
      "from": { "x": 0.5, "y": 0.22 },
      "distance": 0.65,
      "expect": { "screenText": "iOS Version" }
    },
    {
      "id": "capture-about-top",
      "action": "capture",
      "label": "about-top",
      "expect": { "screenText": "iOS Version" }
    },
    {
      "id": "scroll-about-down-1",
      "action": "swipe",
      "direction": "up",
      "from": { "x": 0.5, "y": 0.78 },
      "distance": 0.6
    },
    {
      "id": "scroll-about-down-2",
      "action": "swipe",
      "direction": "up",
      "from": { "x": 0.5, "y": 0.78 },
      "distance": 0.6,
      "expect": { "screenText": "Certificate Trust Settings" }
    },
    {
      "id": "capture-about-bottom",
      "action": "capture",
      "label": "about-bottom",
      "expect": { "screenText": "Certificate Trust Settings" }
    }
  ],
  "postconditions": [
    {
      "all": [
        { "app": { "name": "Settings" } },
        { "screenText": "Certificate Trust Settings" }
      ]
    }
  ]
}
