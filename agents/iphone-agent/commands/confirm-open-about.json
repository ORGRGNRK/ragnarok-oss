{
  "schemaVersion": "0.1",
  "version": "1.0.0",
  "id": "com.yggdrasil.iphone.confirm-open-about",
  "name": "Open About, asking first",
  "description": "Open Settings and General, then ask before opening About. Same steps as Open iPhone About, with the confirmation gate switched on for the final tap.",
  "safety": { "risk": "reversible" },
  "steps": [
    {
      "id": "open-settings-general",
      "action": "openApp",
      "app": { "name": "General" },
      "expect": {
        "all": [{ "app": { "name": "Settings" } }, { "screenText": "About" }]
      }
    },
    {
      "id": "open-about",
      "action": "tap",
      "target": { "text": "About", "minimumConfidence": 0.8 },
      "safety": { "risk": "reversible", "requiresConfirmation": true },
      "expect": { "screenText": "iOS Version" }
    }
  ],
  "postconditions": [
    { "all": [{ "app": { "name": "Settings" } }, { "screenText": "iOS Version" }] }
  ]
}
