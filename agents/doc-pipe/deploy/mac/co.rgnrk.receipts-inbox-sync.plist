<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>co.rgnrk.receipts-inbox-sync</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>@HOME@/Library/Scripts/receipts-inbox-sync.sh</string></array>
  <key>WatchPaths</key><array><string>@HOME@/Receipts-Inbox</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/receipts-inbox-sync.log</string>
</dict></plist>
