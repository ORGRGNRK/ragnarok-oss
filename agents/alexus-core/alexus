def main():
    if len(sys.argv) < 2 or sys.argv[1] in ["-h", "--help", "help"]:
        print(f"""{BOLD}ALEXUS CORE CLI{RESET}
Usage:
  alexus chat                     Open live, conversational chat session with Alexus
  alexus mail-daemon              Run real-time email listener for Alexus's inbox
  alexus mail-setup               Configure iCloud IMAP/SMTP credentials for Alexus's inbox
  alexus imessage-daemon          Run background iMessage listener for iPhone chats
  alexus imessage-reply "<text>"  Process and reply to an incoming message from iPhone
  alexus lookup "<query>"         Instant sub-50ms specialized cartridge knowledge lookup
  alexus ask "<task query>"       Run full Meta-RAG + Conveyor pipeline
  alexus cartridges               List all specialized domain cartridges in vault
  alexus verify-receipts          Cryptographically verify receipts.jsonl hash chain
  alexus status                   Show engine status, vault count, and receipts
  alexus keys                     List all enrolled FIDO2 hardware keys
  alexus enroll-key [label]       Enroll currently connected security key (YubiKey / Identiv)
  alexus setup                    Configure persona interview (Tsundere / Wingman / Engineer)
  alexus auth-test                Trigger native Touch ID / Hardware Key physical check
""")
        return

    cmd = sys.argv[1]
    if cmd in ["chat", "talk", "repl"]:
        cmd_chat()
    elif cmd in ["mail-daemon", "mail", "email-daemon"]:
        mail_bridge.cmd_mail_daemon()
    elif cmd in ["mail-setup", "email-setup"]:
        mail_bridge.cmd_mail_setup()
    elif cmd in ["imessage-daemon", "imsg-daemon", "imessage"]:
        imessage_bridge.cmd_imessage_daemon()
    elif cmd in ["imessage-reply", "imsg-reply"]:
        text = sys.argv[2] if len(sys.argv) > 2 else "Hello"
        handle = sys.argv[3] if len(sys.argv) > 3 else "me"
        imessage_bridge.cmd_imessage_reply(text, handle)
    elif cmd in ["setup", "profile"]:
        cmd_setup()
    elif cmd in ["lookup", "find", "get"]:
        if len(sys.argv) < 3:
            sys.exit(f"{RED}Error: please provide a lookup query.{RESET}")
        cmd_lookup(" ".join(sys.argv[2:]))
    elif cmd == "ask":
        if len(sys.argv) < 3:
            sys.exit(f"{RED}Error: please provide a task description.{RESET}")
        cmd_ask(" ".join(sys.argv[2:]))
    elif cmd in ["cartridges", "vault"]:
        cmd_cartridges()
    elif cmd in ["verify-receipts", "verify-receipt", "verify"]:
        cmd_verify_receipts()
    elif cmd == "status":
        cmd_status()
    elif cmd in ["keys", "list-keys"]:
        cmd_list_keys()
    elif cmd in ["enroll-key", "enroll-yubikey", "yubikey-enroll", "enroll"]:
        label = sys.argv[2] if len(sys.argv) > 2 else None
        cmd_enroll_key(label)
    elif cmd in ["auth-test", "auth", "gate"]:
        cmd_auth_test()
    else:
        cmd_ask(" ".join(sys.argv[1:]))

if __name__ == "__main__":
    main()
