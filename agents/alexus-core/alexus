    greeting = stream_chat(messages + [{"role": "user", "content": greeting_prompt}])
    messages.append({"role": "assistant", "content": greeting})
    print()

    try:
        while True:
            user_input = input(f"{GREEN}{BOLD}{user_name.split()[0]} >{RESET} ").strip()
            if not user_input:
                continue
            if user_input.lower() in ["exit", "quit", "q", "bye"]:
                break
            
            messages.append({"role": "user", "content": user_input})
            print(f"\n{CYAN}{BOLD}Alexus:{RESET} ", end="")
            reply = stream_chat(messages)
            messages.append({"role": "assistant", "content": reply})
            print()
    except (KeyboardInterrupt, EOFError):
        pass

    # Automatic /switch + /end sequence
    print(f"\n\n{MAGENTA}📻 Sealing session into RAGNAROK Switch Packet...{RESET}")
    packet = ragnarok_bridge.auto_switch_and_end(messages, project_slug="alexus-core", ollama_host=OLLAMA_HOST)
    if packet:
        print(f"{GREEN}✅ Switch Packet created: {packet['packet_id']}{RESET}")
        print(f"   Status: Active Target (Sealed in Postgres on alexus)")
        print(f"   Receipt SHA-256: {packet['sha256'][:24]}...")
    else:
        print(f"ℹ️ No conversation to summarize.")
    print(f"{MAGENTA}📻 Comms link terminated. Core locked.{RESET}\n")

