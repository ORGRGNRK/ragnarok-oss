def get_last_receipt():
    if not os.path.exists(RECEIPTS_FILE):
        return None
    last_line = None
    with open(RECEIPTS_FILE, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line:
                last_line = line
    if last_line:
        try:
            return json.loads(last_line)
        except Exception:
            return None
    return None

def append_receipt(task, cartridges, total_s, verification_results):
    last = get_last_receipt()
    index = (last.get("index", -1) + 1) if last else 0
    prev_hash = last.get("receipt_hash", "0" * 64) if last else "0" * 64
    timestamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    
    payload = {
        "index": index,
        "timestamp": timestamp,
        "task": task,
        "cartridges": cartridges,
        "execution_seconds": round(total_s, 2),
        "verification": verification_results
    }
    payload_str = json.dumps(payload, sort_keys=True)
    payload_hash = hashlib.sha256(payload_str.encode("utf-8")).hexdigest()
    
    chain_seed = f"{index}:{timestamp}:{prev_hash}:{payload_hash}"
    receipt_hash = hashlib.sha256(chain_seed.encode("utf-8")).hexdigest()
    
    record = {
        **payload,
        "prev_receipt_hash": prev_hash,
        "payload_hash": payload_hash,
        "receipt_hash": receipt_hash
    }
    
    with open(RECEIPTS_FILE, "a", encoding="utf-8") as fp:
        fp.write(json.dumps(record) + "\n")
    return record

def cmd_verify_receipts():
    """Validates the cryptographic hash chain of receipts.jsonl from genesis to head."""
    if not os.path.exists(RECEIPTS_FILE):
        print(f"{YELLOW}No receipts found at {RECEIPTS_FILE}.{RESET}")
        return

    print(f"\n{BOLD}🔍 Verifying Cryptographic Receipt Ledger Chain...{RESET}\n")
    prev_hash = "0" * 64
    valid_count = 0

    with open(RECEIPTS_FILE, "r", encoding="utf-8") as fp:
        for line_no, line in enumerate(fp, start=1):
            line = line.strip()
            if not line:
                continue
            rec = json.loads(line)
            
            actual_prev = rec.get("prev_receipt_hash")
            if actual_prev != prev_hash:
                print(f"{RED}❌ TAMPER DETECTED at entry #{rec.get('index', line_no)} (line {line_no}):{RESET}")
                print(f"   Expected prev_hash: {prev_hash}")
                print(f"   Found prev_hash:    {actual_prev}")
                sys.exit(1)

            payload = {
                "index": rec["index"],
                "timestamp": rec["timestamp"],
                "task": rec["task"],
                "cartridges": rec["cartridges"],
                "execution_seconds": rec["execution_seconds"],
                "verification": rec["verification"]
            }
            computed_payload_hash = hashlib.sha256(json.dumps(payload, sort_keys=True).encode("utf-8")).hexdigest()
            if computed_payload_hash != rec.get("payload_hash"):
                print(f"{RED}❌ PAYLOAD TAMPER DETECTED at entry #{rec.get('index', line_no)}:{RESET}")
                print(f"   Payload hash mismatch.")
                sys.exit(1)

            chain_seed = f"{rec['index']}:{rec['timestamp']}:{actual_prev}:{computed_payload_hash}"
            computed_receipt_hash = hashlib.sha256(chain_seed.encode("utf-8")).hexdigest()
            if computed_receipt_hash != rec.get("receipt_hash"):
                print(f"{RED}❌ RECEIPT HASH MISMATCH at entry #{rec.get('index', line_no)}!{RESET}")
                sys.exit(1)

            prev_hash = rec["receipt_hash"]
            valid_count += 1
            print(f"  {GREEN}✓{RESET} Block #{rec['index']} | Task: {rec['task'][:40]}... | Hash: {rec['receipt_hash'][:16]}...")

    print(f"\n{GREEN}✅ ALL {valid_count} BLOCKS CRYPTOGRAPHICALLY VERIFIED (Linear chain intact, 0 collisions).{RESET}\n")

