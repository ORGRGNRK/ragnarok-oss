def verify_hardware_presence(force_check=None):
    """Enforces physical hardware presence (FIDO2 Hardware Key OR Apple Touch ID biometrics).

    FAILS CLOSED (2026-10-30). There is no way to switch this off for a protected action:
      - no terminal on stdin (a script, a pipe, a daemon, an AI tool)  -> refused
      - ALEXUS_REQUIRE_AUTH=0 (the old off-switch)                     -> ignored, still checked
      - neither the FIDO2 script + an enrolled key nor bin/auth-gate   -> refused
    `force_check` is kept so old callers still work; the check always runs."""
    if os.environ.get("ALEXUS_REQUIRE_AUTH", "1") != "1":
        print(f"{YELLOW}ℹ️ ALEXUS_REQUIRE_AUTH no longer switches the hardware check off; checking anyway.{RESET}",
              file=sys.stderr)

    # Headless (no person at a terminal to touch the key): refuse instead of waving it through.
    try:
        tty = sys.stdin is not None and sys.stdin.isatty()
    except (AttributeError, ValueError):
        tty = False
    if not tty:
        return _refuse("this command needs a person at a terminal to touch the hardware key or Touch ID "
                       "(stdin is not a TTY). Nothing was run.")

    enrolled_keys = get_enrolled_keys()
    legacy_enrolled = os.path.exists(os.path.expanduser("~/.alexus/credential_id.txt"))
    
    # Priority 1: Hardware Security Key (YubiKey / Identiv uTrust) if enrolled
    if (enrolled_keys or legacy_enrolled) and os.path.exists(FIDO_AUTH_BIN):
        ret = os.system(FIDO_AUTH_BIN)
        exit_code = ret >> 8
        if exit_code == 0:
            print(f"{GREEN}✅ Cryptographic hardware assertion verified. Access granted.{RESET}\n")
            return True
        elif exit_code == 3:
            # Key not plugged in; proceed to Priority 2 fallback
            print(f"ℹ️ Hardware key not inserted. Falling back to Secure Enclave biometrics...")
        else:
            print(f"\n{RED}❌ AUTHENTICATION REFUSED: Hardware key touch was not confirmed.{RESET}")
            render_star_fox_hud("Alexus", "Access denied! Hardware key touch failed, b-baka!\nOnly my owner's physical key can unlock my core!", emotion="💢")
            return False

    # Priority 2: Native Apple Touch ID Biometrics (Secure Enclave)
    if os.path.exists(AUTH_GATE_BIN):
        print(f"\n{YELLOW}🔐 PHYSICAL HARDWARE PRESENCE REQUIRED (TOUCH ID){RESET}")
        print(f"👉 Please touch your {BOLD}Touch ID sensor{RESET} on your Mac keyboard...")
        ret = os.system(AUTH_GATE_BIN)
        if ret == 0:
            print(f"{GREEN}✅ Touch ID verified via Secure Enclave. Access granted.{RESET}\n")
            return True
        else:
            print(f"\n{RED}❌ AUTHENTICATION REFUSED: Touch ID was canceled or not recognized.{RESET}")
            render_star_fox_hud("Alexus", "Access denied! Touch ID failed, b-baka!\nOnly my owner's fingerprint can unlock my core!", emotion="💢")
            return False

    # No usable gate on this machine (no FIDO2 key path and no bin/auth-gate): fail closed.
    return _refuse(f"no hardware gate available (no enrolled FIDO2 key with {FIDO_AUTH_BIN}, and no "
                   f"Touch ID gate at {AUTH_GATE_BIN}; build it with ./build-auth.sh). Nothing was run.")

def get_embedding(text):
    url = f"{OLLAMA_HOST}/api/embeddings"
    data = json.dumps({"model": "nomic-embed-text", "prompt": text}).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            res = json.loads(resp.read().decode("utf-8"))
            return res["embedding"]
    except Exception as e:
        sys.exit(f"{RED}Error connecting to Alexus Ollama at {OLLAMA_HOST}: {e}{RESET}")

def cosine_similarity(v1, v2):
    dot = sum(a * b for a, b in zip(v1, v2))
    norm1 = math.sqrt(sum(a * a for a in v1))
    norm2 = math.sqrt(sum(b * b for b in v2))
    return dot / (norm1 * norm2) if norm1 and norm2 else 0.0

def generate_completion(prompt, model="llama3.2:3b", max_retries=1):
    url = f"{OLLAMA_HOST}/api/generate"
    data = json.dumps({"model": model, "prompt": prompt, "stream": False}).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            res = json.loads(resp.read().decode("utf-8"))
            return res.get("response", "").strip()
    except Exception as e:
        return f"[Inference Error: {e}]"

def load_cartridges():
    experts = []
    for f in sorted(glob.glob(os.path.join(CARTRIDGES_DIR, "*.json"))):
        with open(f, "r") as fp:
            data = json.load(fp)
            experts.append(data)
    for exp in experts:
        stds = " ".join(exp.get("standards", []))
        blob = f"{exp['domain']} {stds} {exp['description']}"
        exp["embedding"] = get_embedding(blob)
    return experts

