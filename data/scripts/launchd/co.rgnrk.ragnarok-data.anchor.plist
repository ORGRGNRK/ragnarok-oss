<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly off-server anchor of the Ragnarok data-layer receipt chain (runs scripts/mac-anchor.sh on the Mac).
  NOT installed by anything. To install (see README, "Off-server anchors"):
    cp scripts/mac-anchor.sh ~/.local/bin/ragnarok-data-anchor.sh
    cp scripts/launchd/co.rgnrk.ragnarok-data.anchor.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/co.rgnrk.ragnarok-data.anchor.plist
  launchd does not expand ~, so the paths below are absolute for the Mac user "yggdrasil".
-->
<plist version="1.0">
<!-- Template: install with  sed "s|@HOME@|$HOME|g" THIS > ~/Library/LaunchAgents/NAME.plist  (launchd does not expand ~). -->
<dict>
  <key>Label</key>
  <string>co.rgnrk.ragnarok-data.anchor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@HOME@/.local/bin/ragnarok-data-anchor.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    <key>ANCHOR_SSH_TARGET</key>
    <string>alexus</string>
    <key>ANCHOR_SSH_KEY</key>
    <string>@HOME@/.ssh/ragnarok_anchor_ed25519</string>
    <key>ANCHOR_REMOTE_CMD</key>
    <string>anchor</string>
    <key>ANCHOR_DIR</key>
    <string>@HOME@/RAGNAROK-anchors</string>
    <key>ANCHOR_NAME</key>
    <string>ragnarok-data</string>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/ragnarok-data-anchor.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/ragnarok-data-anchor.err.log</string>
</dict>
</plist>
