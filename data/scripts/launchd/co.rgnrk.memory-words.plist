<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Every hour: the owner's new Claude Code messages -> memory.words (+ nomic vectors on Alexus), so Muse's
     memory_search_words stays current (scripts/memory.py import-words). Log: ~/.ragnarok/memory-words.log
     Install (a person runs this):
       cp ~/Developer/ragnarok/data/scripts/launchd/co.rgnrk.memory-words.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/co.rgnrk.memory-words.plist
     Remove: launchctl bootout gui/$(id -u)/co.rgnrk.memory-words -->
<plist version="1.0"><dict>
  <key>Label</key><string>co.rgnrk.memory-words</string>
  <key>ProgramArguments</key><array>
    <string>/bin/sh</string><string>-c</string>
    <string>date -u +"== %Y-%m-%dT%H:%M:%SZ"; exec /usr/bin/python3 -I "$HOME/Developer/ragnarok/data/scripts/memory.py" import-words</string>
  </array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>@HOME@/.orbstack/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>@HOME@/.ragnarok/memory-words.log</string>
  <key>StandardErrorPath</key><string>@HOME@/.ragnarok/memory-words.log</string>
</dict></plist>
