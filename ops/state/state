    # mounts on this partition or anything stacked on it (LUKS -> LVM -> fs)
    out = [x for x in (n.get("mountpoints") or []) if x]
    for c in n.get("children", []) or []:
        out += allmounts(c)
    return out
bl = json.loads(run("lsblk -J -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINTS,VENDOR,MODEL,TRAN") or "{}")
s["disks"] = [{"name": d["name"], "size": d["size"], "model": f'{(d.get("vendor") or "").strip()} {(d.get("model") or "").strip()}'.strip(),
               "tran": d.get("tran"),
               "parts": [{"name": p["name"], "size": p["size"], "fs": p.get("fstype"), "label": p.get("label"),
                          "mounted": allmounts(p)} for p in d.get("children", [])]}
              for d in bl.get("blockdevices", []) if d.get("type") == "disk"]
s["failed_units"] = run("systemctl --failed --no-legend --plain | awk '{print $1}'").split()
s["key_services"] = {u: run(f"systemctl is-active {u}").strip() for u in
                     ["ygg-trunk.service", "docker.service", "tailscaled.service", "auditd.service", "ssh.service", "cloudflared.service"]}
s["user_services"] = run("systemctl --user list-units --type=service --state=running --no-legend --plain | awk '{print $1}'").split()
s["timers"] = {"system": run("systemctl list-timers --all --no-legend --plain | awk '{print $(NF-1)}'").split(),
               "user": run("systemctl --user list-timers --all --no-legend --plain | awk '{print $(NF-1)}'").split()}
s["crontab"] = [l for l in run("crontab -l 2>/dev/null").splitlines() if l.strip() and not l.startswith("#")]
cs = []
for line in run("docker ps -a --format '{{.Names}}|{{.Image}}|{{.Status}}|{{.Ports}}'").splitlines():
    n, img, st, ports = (line.split("|") + ["", "", "", ""])[:4]
    rp = run(f"docker inspect -f '{{{{.HostConfig.RestartPolicy.Name}}}}' {n}").strip()
    cs.append({"name": n, "image": img, "status": st, "restart": rp,
               "public_ports": sorted(set(re.findall(r"0\.0\.0\.0:(\d+)", ports)))})
s["containers"] = cs
lis = run("ss -tlnH | awk '{print $4}'").split()
s["listening_all_interfaces"] = sorted({a.rsplit(":",1)[1] for a in lis if a.startswith("0.0.0.0:") or a.startswith("[::]:") or a.startswith("*:")}, key=int)
s["firewall_ufw"] = run("grep -h ^ENABLED /etc/ufw/ufw.conf").strip()
s["tunnel"] = {"cloudflared_installed": bool(run("command -v cloudflared").strip()),
               "cloudflared_running": bool(run("pgrep -x cloudflared").strip())}
s["tailscale_ip"] = run("ip -4 -o addr show tailscale0 | awk '{print $4}'").strip()
g = []
for d in sorted(glob.glob(os.path.expanduser("~/Developer/*/.git"))):
    d = os.path.dirname(d)
    g.append({"repo": os.path.basename(d),
              "head": run(f"git -C '{d}' log -1 --format='%h %cs'").strip(),
              "dirty": len([l for l in run(f"git -C '{d}' status --porcelain").splitlines() if l.strip()])})
