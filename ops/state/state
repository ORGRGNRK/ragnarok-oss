def run(c, t=20):
    try:
        p = subprocess.run(c, shell=True, capture_output=True, text=True, timeout=t); return p.stdout
    except Exception as e: return ""
s = {}
s["host"] = run("hostname").strip()
s["os"] = run(". /etc/os-release; echo $PRETTY_NAME").strip()
s["uptime"] = run("uptime -p").strip()
s["timezone"] = run("timedatectl show -p Timezone --value").strip()
m = run("free -b").split("\n")[1].split()
s["mem_gb"] = {"total": round(int(m[1])/1e9,1), "available": round(int(m[6])/1e9,1)}
s["root_disk"] = run("df -h / | tail -1").split()
s["root_lv_vs_disk"] = run("lsblk -bdno SIZE /dev/nvme0n1").strip() and {
    "lv_gb": round(int(run("lsblk -bno SIZE /dev/mapper/ubuntu--vg-ubuntu--lv").split()[0])/1e9),
    "disk_gb": round(int(run("lsblk -bdno SIZE /dev/nvme0n1").strip())/1e9)}
