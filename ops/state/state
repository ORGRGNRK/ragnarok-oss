'''


def alexus():
    for target, via in ((ALEXUS, "lan"), (ALEXUS_TS, "tailscale")):
        code, out, err = run(["/usr/bin/ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6",
                              f"{ALEXUS_USER}@{target}" if ALEXUS_USER else target,
                              "python3", "-I", "-"], timeout=90, inp=ALEXUS_PROBE)
        if code == 0 and out.strip():
            try:
                d = json.loads(out); d["reached_via"] = via; return d
            except Exception as e:
                return {"error": f"bad probe output: {e}"}
    return {"error": f"unreachable on LAN and Tailscale: {err.strip()[:200]}"}


def summary(st):
    L = [f"state @ {st['taken_at']}"]
    m = st["mac"]
    L.append(f"MAC {m['host']} macOS {m['os']} | disk {m['disk']}")
    bad = [a["label"] for a in m["launch_agents"] if not a.get("loaded")]
    L.append(f"  launch agents: {len(m['launch_agents'])} ({'not loaded: ' + ', '.join(bad) if bad else 'all loaded'})")
    L.append(f"  security keys plugged in: {', '.join(m['security_keys_plugged']) or 'none'}")
    L.append(f"  external disks: {len([d for d in m['external_disks'] if d.startswith('/dev/')])}")
    dirty = [f"{g['repo']}({g['dirty']})" for g in m["git"] if g["dirty"]]
    L.append(f"  git repos: {len(m['git'])}, uncommitted changes in: {', '.join(dirty) or 'none'}")
    a = st["alexus"]
    if "error" in a:
        L.append(f"ALEXUS: {a['error']}")
    else:
        L.append(f"ALEXUS {a['host']} {a['os']} via {a['reached_via']} | {a['uptime']} | tz {a['timezone']}")
        lv = a.get("root_lv_vs_disk")
        lv_txt = f" (LV {lv['lv_gb']} GB of {lv['disk_gb']} GB disk)" if isinstance(lv, dict) else ""
        L.append(f"  mem avail {a['mem_gb']['available']}/{a['mem_gb']['total']} GB | root {a['root_disk'][2]} used of {a['root_disk'][1]}{lv_txt}")
        for d in a["disks"]:
            for p in d["parts"]:
                L.append(f"  disk {d['name']} {d['model']} {p['name']} {p['size']} {p['label'] or ''} -> {'mounted ' + ','.join(p['mounted']) if p['mounted'] else 'NOT MOUNTED'}")
        L.append(f"  services: " + ", ".join(f"{k.split('.')[0]}={v}" for k, v in a["key_services"].items()))
        L.append(f"  failed units: {', '.join(a['failed_units']) or 'none'}")
        L.append(f"  timers (user): {', '.join(a['timers']['user']) or 'none'} | cron lines: {len(a['crontab'])}")
        up = sum(1 for c in a["containers"] if c["status"].startswith("Up"))
        L.append(f"  containers: {up}/{len(a['containers'])} up; public ports: "
                 + (", ".join(f"{c['name']}:{'/'.join(c['public_ports'])}" for c in a["containers"] if c["public_ports"]) or "none"))
        L.append(f"  listening on all interfaces: {', '.join(a['listening_all_interfaces'])} | firewall {a['firewall_ufw']}")
        L.append(f"  tunnel: cloudflared installed={a['tunnel']['cloudflared_installed']} running={a['tunnel']['cloudflared_running']}")
        dirty = [f"{g['repo']}({g['dirty']})" for g in a["git"] if g["dirty"]]
        L.append(f"  git repos: {len(a['git'])}, uncommitted changes in: {', '.join(dirty) or 'none'}")
    return "\n".join(L)


def main():
    st = {"taken_at": time.strftime("%Y-%m-%d %H:%M:%S %Z"), "mac": mac(), "alexus": alexus()}
    os.makedirs(OUT_DIR, exist_ok=True)
    path = os.path.join(OUT_DIR, "latest.json")
    with open(path + ".tmp", "w") as f:
        json.dump(st, f, indent=1)
    os.replace(path + ".tmp", path)
    print(json.dumps(st, indent=1) if "--json" in sys.argv else summary(st) + f"\n(full: {path})")


if __name__ == "__main__":
    main()
