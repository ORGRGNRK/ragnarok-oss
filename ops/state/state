#!/usr/bin/env python3
"""state — machine memory. Asks the Mac and Alexus what is true right now. Read-only.

  state            print a short summary, save full JSON to ~/.ragnarok/state/latest.json
  state --json     print the full JSON
Nothing here is remembered: every field is measured at run time. A field that could not be
measured says so ("error": ...) instead of guessing.
"""
import json, os, platform, plistlib, re, subprocess, sys, time, glob



def _local_conf(key, default):
    """KEY=value from ~/.ragnarok/local.conf (read only, never executed)."""
    try:
        for line in open(os.path.expanduser("~/.ragnarok/local.conf")):
            k, _, v = line.strip().partition("=")
            if k == key and v:
                return v
    except OSError:
        pass
    return default


ALEXUS = _local_conf("ALEXUS_HOST", "alexus")
ALEXUS_TS = _local_conf("ALEXUS_TAILSCALE", "alexus")
ALEXUS_USER = _local_conf("ALEXUS_USER", "")
OUT_DIR = os.path.expanduser("~/.ragnarok/state")


def run(cmd, timeout=20, inp=None):
    try:
        p = subprocess.run(cmd, input=inp, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except Exception as e:  # noqa
        return 99, "", str(e)


def git_repos(root):
    out = []
    for g in sorted(glob.glob(os.path.join(root, "*", ".git"))):
        d = os.path.dirname(g)
        _, br, _ = run(["git", "-C", d, "rev-parse", "--abbrev-ref", "HEAD"])
        _, head, _ = run(["git", "-C", d, "log", "-1", "--format=%h %cs"])
        _, st, _ = run(["git", "-C", d, "status", "--porcelain"])
        _, rem, _ = run(["git", "-C", d, "remote"])
        out.append({"repo": os.path.basename(d), "branch": br.strip(), "head": head.strip(),
                    "dirty": len([l for l in st.splitlines() if l.strip()]), "has_remote": bool(rem.strip())})
    return out


def mac():
    s = {"host": platform.node(), "os": platform.mac_ver()[0]}
    _, up, _ = run(["uptime"]); s["uptime"] = up.strip()
    _, df, _ = run(["df", "-h", "/System/Volumes/Data"]); s["disk"] = df.splitlines()[-1] if df else None
    # launch agents: schedule + loaded state + last exit
    _, ll, _ = run(["launchctl", "list"])
    loaded = {}
    for line in ll.splitlines()[1:]:
        parts = line.split("\t")
        if len(parts) == 3:
            loaded[parts[2]] = {"pid": parts[0], "last_exit": parts[1]}
    agents = []
    for f in sorted(glob.glob(os.path.expanduser("~/Library/LaunchAgents/co.rgnrk.*.plist"))):
        try:
            p = plistlib.load(open(f, "rb"))
        except Exception as e:
            agents.append({"file": os.path.basename(f), "error": str(e)}); continue
        lab = p.get("Label", "")
        sched = ("keepalive" if p.get("KeepAlive") else
                 f"every {p['StartInterval']}s" if "StartInterval" in p else
                 "calendar" if "StartCalendarInterval" in p else
                 "at load only" if p.get("RunAtLoad") else "manual")
        L = loaded.get(lab)
        agents.append({"label": lab, "schedule": sched, "loaded": bool(L),
                       "running": bool(L and L["pid"] != "-"), "last_exit": L and L["last_exit"]})
    s["launch_agents"] = agents
    _, ls, _ = run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"])
    s["listening"] = sorted({f"{l.split()[0]} {l.split()[8]}" for l in ls.splitlines()[1:] if len(l.split()) > 8})
    _, dl, _ = run(["diskutil", "list", "external", "physical"])
    s["external_disks"] = [l.strip() for l in dl.splitlines() if l.startswith("/dev/") or re.match(r"\s+\d+:", l)]
    _, io, _ = run(["ioreg", "-p", "IOUSB", "-l", "-w0"], timeout=10)
    s["security_keys_plugged"] = sorted(set(re.findall(r'"USB Product Name" = "([^"]*(?:YubiKey|uTrust|FIDO|Security Key)[^"]*)"', io)))
    try:
        hooks = json.load(open(os.path.expanduser("~/.claude/settings.json"))).get("hooks", {})
        s["claude_hooks"] = {ev: [os.path.basename((h.get("command") or "").split()[-1] if h.get("command") else "?")
                                  for m in lst for h in m.get("hooks", [])] for ev, lst in hooks.items()}
    except Exception as e:
        s["claude_hooks"] = {"error": str(e)}
    s["git"] = git_repos(os.path.expanduser("~/Developer"))
    return s


ALEXUS_PROBE = r'''
